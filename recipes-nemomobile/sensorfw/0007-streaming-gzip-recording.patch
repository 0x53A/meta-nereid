diff --git a/tests/recording/gzip-test.cpp b/tests/recording/gzip-test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/recording/gzip-test.cpp
@@ -0,0 +1,34 @@
+#include "../../core/hybrisrawstorage.h"
+#include <cassert>
+#include <fstream>
+#include <iterator>
+#include <sys/wait.h>
+#include <vector>
+std::string read(const std::string &p) { std::ifstream f(p); return {std::istreambuf_iterator<char>(f),{}}; }
+int main() {
+ char path[]="/tmp/hoki-gzip-XXXXXX";assert(mkdtemp(path));
+ const pid_t child=fork();assert(child>=0);
+ if (!child) {
+  HybrisRawStorage s(path,"test",16+88*2,0,0,true);
+  HybrisRawQueue::Record r;
+  s.append(r);s.checkpoint(0,0); // Complete gzip member, still open stream.
+  r.sequence=1;s.append(r);s.checkpoint(0,0);
+  r.sequence=2;s.append(r);s.checkpoint(0,0,true); // Rotated segment.
+  _exit(0); // No gzip destructor/final close may be required for recovery.
+ }
+ int status;waitpid(child,&status,0);assert(WIFEXITED(status)&&WEXITSTATUS(status)==0);
+ std::string root=path;
+ for (int i=0;i<2;i++) {
+  auto name=root+(i?"/events-000001.bin.gz":"/events-000000.bin.gz");
+  gzFile f=gzopen(name.c_str(),"rb");assert(f);unsigned char data[256];int n=gzread(f,data,sizeof data);
+  assert(n==(i?104:192));assert(std::string((char*)data,8)=="HOKISEN1");assert(gzclose(f)==Z_OK);
+ }
+ assert(read(root+"/checkpoint.json").find("\"compression\":\"gzip\"")!=std::string::npos);
+ // Normal destruction after final checkpoint must not append uncommitted bytes.
+ char other[]="/tmp/hoki-gzip-close-XXXXXX";assert(mkdtemp(other));off_t length;
+ {
+  HybrisRawStorage s(other,"test",104,0,0,true);HybrisRawQueue::Record r;s.append(r);s.checkpoint(0,0,true);
+  struct stat st;assert(stat((std::string(other)+"/events-000000.bin.gz").c_str(),&st)==0);length=st.st_size;
+ }
+ struct stat st;assert(stat((std::string(other)+"/events-000000.bin.gz").c_str(),&st)==0);assert(st.st_size==length);
+}
