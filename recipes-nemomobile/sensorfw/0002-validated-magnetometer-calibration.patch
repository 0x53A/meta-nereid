diff --git a/tests/magcalibration/hardiron-test.cpp b/tests/magcalibration/hardiron-test.cpp
new file mode 100644
index 0000000..a4ab70f
--- /dev/null
+++ b/tests/magcalibration/hardiron-test.cpp
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "hardironcalibration.h"
+#include <cassert>
+#include <iostream>
+#include <limits>
+
+using Calibration = HardIronCalibration;
+using Vector = Calibration::Vector;
+
+static Vector sphere(int i, double radius = 48)
+{
+    // Golden-angle directions with all three axes covered throughout the run.
+    const double z = 1.0 - 2.0*((i*37)%120 + 0.5)/120;
+    const double angle = i*2.399963229728653;
+    const double r = std::sqrt(1-z*z);
+    return {{125 + radius*r*std::cos(angle), -72 + radius*r*std::sin(angle), 31 + radius*z}};
+}
+int main()
+{
+    Calibration c;
+    for (int i = 0; i < 1000; ++i)
+        c.add({{0, 0, 0}});
+    assert(!c.valid());
+    for (int i = 0; i < 1000; ++i)
+        c.add({{125, -72, 79}});
+    assert(!c.valid());
+    c.reset();
+    // A circle, including tilted planes, must not be accepted as a sphere.
+    for (int i = 0; i < 360; ++i) {
+        const double angle = i*0.0174532925199433;
+        c.add({{125 + 34*std::cos(angle), -72 + 34*std::sin(angle),
+                31 + 24*(std::cos(angle)+std::sin(angle))}});
+    }
+    assert(!c.valid());
+    c.reset();
+    for (int i = 0; i < 240; ++i)
+        c.add(sphere(i));
+    assert(c.valid());
+    assert(std::abs(c.offset()[0]-125) < 0.01);
+    assert(std::abs(c.offset()[1]+72) < 0.01);
+    assert(std::abs(c.offset()[2]-31) < 0.01);
+    assert(std::abs(c.radius()-48) < 0.01);
+    for (int i = 0; i < 100; ++i)
+        assert(c.level(sphere(i)) == 3);
+    assert(c.level({{125, -72, 200}}) == 0);
+    assert(c.level({{NAN, 0, 0}}) == 0);
+    auto offset = c.offset();
+    for (int i = 0; i < 100; ++i)
+        assert(!c.add({{500, 500, 500}}));
+    assert(c.offset() == offset); // disturbance cannot replace saved offsets
+    Calibration restored;
+    assert(restored.restore(c.offset(), c.radius()));
+    assert(restored.level(sphere(0)) == 3);
+    c.reset();
+    assert(!c.valid());
+    assert(c.level(sphere(0)) == 0);
+    for (int i = 0; i < 240; ++i) {
+        Vector v = sphere(i);
+        v[0] += 0.4*std::sin(i*3.1);
+        v[1] += 0.4*std::cos(i*2.3);
+        c.add(v);
+    }
+    assert(c.valid());
+    assert(std::abs(c.offset()[0]-125) < 1);
+    c.reset();
+    for (int i = 0; i < 240; ++i)
+        c.add(sphere(i, 500));
+    assert(!c.valid()); // charger/strong field
+    c.reset();
+    for (int i = 0; i < 240; ++i) {
+        auto v = sphere(i);
+        v[0] = 125 + (v[0]-125)*1.6;
+        c.add(v);
+    }
+    assert(!c.valid()); // unsupported soft-iron distortion
+    assert(!c.restore({{NAN, 0, 0}}, 48));
+    assert(!c.restore({{0, 0, 0}}, 0));
+    assert(!c.restore({{0, 0, 0}}, INFINITY));
+    assert(!c.restore({{2000, 0, 0}}, 48));
+    assert(!c.add({{NAN, 0, 0}}));
+    assert(!c.add({{INFINITY, 0, 0}}));
+    std::cout << "PASS: stationary, planar, hard-iron fit, noise, confidence, reset, restore, disturbance and invalid data\n";
+}
