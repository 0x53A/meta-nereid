+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "calibrationfilter.h"
+#include "config.h"
+#include <QCoreApplication>
+#include <QTemporaryDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <cassert>
+#include <iostream>
+
+struct Capture {
+    CalibratedMagneticFieldData value;
+    Sink<Capture, CalibratedMagneticFieldData> sink;
+    Capture() : sink(this, &Capture::receive) {}
+    void receive(unsigned, const CalibratedMagneticFieldData *data) { value = *data; }
+};
+class TestFilter : public CalibrationFilter {
+public:
+    TestFilter(Capture &capture) { source_.join(&capture.sink); }
+    void feed(CalibratedMagneticFieldData data) {
+        static_cast<SinkTyped<CalibratedMagneticFieldData> *>(&sink_)->collect(1, &data);
+    }
+};
+static CalibratedMagneticFieldData sample(int i) {
+    const double z = 1.0 - 2.0*((i*37)%120 + 0.5)/120;
+    const double r = std::sqrt(1-z*z), angle = i*2.399963229728653;
+    return CalibratedMagneticFieldData(i+1, 1, 2, 3,
+        125000 + 48000*r*std::cos(angle), -72000 + 48000*r*std::sin(angle),
+        31000 + 48000*z, 0);
+}
+static void writeFile(const QString &path, const QByteArray &bytes) {
+    QFile f(path);
+    assert(f.open(QIODevice::WriteOnly));
+    assert(f.write(bytes) == bytes.size());
+}
+int main(int argc, char **argv) {
+    QCoreApplication app(argc, argv);
+    QTemporaryDir dir;
+    assert(dir.isValid());
+    const QString config = dir.path()+"/config.ini", saved = dir.path()+"/state/calibration.json";
+    const auto loadConfig = [&](bool manual, const QString &matrix) {
+        SensorFrameworkConfig::close();
+        writeFile(config, ("[plugins]\nmagnetometeradaptor=test\n[magnetometer]\nneeds_calibration="
+            + QString(manual ? "1" : "0") + "\ntransformation_matrix=\"" + matrix
+            + "\"\ncalibration_file=" + saved + "\n").toUtf8());
+        assert(SensorFrameworkConfig::loadConfig(config, dir.path()+"/absent"));
+    };
+    loadConfig(true, "1,0,0,0,1,0,0,0,1");
+    Capture capture;
+    {
+        TestFilter f(capture);
+        for (int i = 0; i < 100; ++i)
+            f.feed(CalibratedMagneticFieldData(i+1, 1, 2, 3, 0, 0, 0, 0));
+        assert(capture.value.level_ == 0);
+        assert(!QFile::exists(saved));
+        for (int i = 0; i < 240; ++i)
+            f.feed(sample(i));
+        assert(capture.value.level_ == 3);
+        assert(QFile::exists(saved));
+        auto expected = sample(239);
+        assert(std::abs(capture.value.x_ - (expected.rx_-125000)) < 10);
+        assert(capture.value.rx_ == expected.rx_);
+        assert(capture.value.timestamp_ == expected.timestamp_);
+    }
+    {
+        TestFilter f(capture); // restore into a new instance
+        f.feed(sample(17));
+        assert(capture.value.level_ == 3);
+        f.dropCalibration();
+        assert(!QFile::exists(saved));
+        f.feed(sample(17));
+        assert(capture.value.level_ == 0);
+        for (int i = 0; i < 240; ++i) f.feed(sample(i));
+        assert(capture.value.level_ == 3);
+    }
+    QFile savedFile(saved);
+    assert(savedFile.open(QIODevice::ReadOnly));
+    const QByteArray good = savedFile.readAll();
+    savedFile.close();
+    loadConfig(true, "-1,0,0,0,1,0,0,0,1");
+    { TestFilter f(capture); f.feed(sample(17)); assert(capture.value.level_ == 0); }
+    loadConfig(true, "1,0,0,0,1,0,0,0,1");
+    writeFile(saved, "{broken");
+    { TestFilter f(capture); f.feed(sample(17)); assert(capture.value.level_ == 0); }
+    auto object = QJsonDocument::fromJson(good).object();
+    object.insert("radius", -1);
+    writeFile(saved, QJsonDocument(object).toJson());
+    { TestFilter f(capture); f.feed(sample(17)); assert(capture.value.level_ == 0); }
+    loadConfig(false, "1,0,0,0,1,0,0,0,1");
+    { TestFilter f(capture); auto s = sample(17); s.level_ = 2; f.feed(s);
+      assert(capture.value.x_ == 1 && capture.value.y_ == 2 && capture.value.z_ == 3);
+      assert(capture.value.level_ == 2); }
+    SensorFrameworkConfig::close();
+    std::cout << "PASS: real filter stationary, fit, raw data/timestamp, save/load, reset, invalid file/context and HAL passthrough\n";
+}
