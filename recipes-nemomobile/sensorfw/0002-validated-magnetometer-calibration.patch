diff --git a/chains/magcalibrationchain/hardironcalibration.h b/chains/magcalibrationchain/hardironcalibration.h
new file mode 100644
index 0000000..6c4a15b
--- /dev/null
+++ b/chains/magcalibrationchain/hardironcalibration.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef HARDIRONCALIBRATION_H
+#define HARDIRONCALIBRATION_H
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+
+// Hard-iron sphere fit. Input/output units are microtesla. Unlike extrema
+// stability, a full-rank fit with directional coverage cannot calibrate a
+// stationary sensor. Soft-iron distortion is not corrected by this model.
+class HardIronCalibration
+{
+public:
+    using Vector = std::array<double, 3>;
+
+    void reset() { *this = HardIronCalibration(); }
+    bool valid() const { return valid_; }
+    const Vector &offset() const { return offset_; }
+    double radius() const { return radius_; }
+
+    bool restore(const Vector &offset, double radius)
+    {
+        if (!finite(offset) || norm(offset) > 1000 ||
+                !std::isfinite(radius) || radius < 20 || radius > 100)
+            return false;
+        offset_ = offset;
+        radius_ = radius;
+        valid_ = true;
+        return true;
+    }
+
+    Vector corrected(const Vector &sample) const
+    {
+        Vector result = sample;
+        if (valid_)
+            for (int axis = 0; axis < 3; ++axis)
+                result[axis] -= offset_[axis];
+        return result;
+    }
+
+    int level(const Vector &sample) const
+    {
+        if (!valid_ || !finite(sample))
+            return 0;
+        const double error = std::abs(norm(corrected(sample)) - radius_) / radius_;
+        return error <= 0.10 ? 3 : error <= 0.20 ? 1 : 0;
+    }
+
+    // Returns true only when a new calibration has been accepted. Retain it
+    // until an explicit reset; a passing magnet must not replace good offsets.
+    bool add(const Vector &sample)
+    {
+        if (valid_ || !finite(sample) || norm(sample) > 2000)
+            return false;
+        for (const Vector &point : samples_) {
+            Vector delta;
+            for (int axis = 0; axis < 3; ++axis)
+                delta[axis] = sample[axis] - point[axis];
+            if (norm(delta) < 3)
+                return false;
+        }
+        if (samples_.size() == 128)
+            samples_.erase(samples_.begin());
+        samples_.push_back(sample);
+        if (samples_.size() < 32 || ++sinceFit_ < 8)
+            return false;
+        sinceFit_ = 0;
+        return fit();
+    }
+
+private:
+    static bool finite(const Vector &v)
+    {
+        return std::isfinite(v[0]) && std::isfinite(v[1]) && std::isfinite(v[2]);
+    }
+    static double norm(const Vector &v)
+    {
+        return std::sqrt(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
+    }
+
+    bool fit()
+    {
+        // Center samples first to keep the normal equations well-conditioned
+        // even when the hard-iron offset is large compared with Earth's field.
+        Vector mean = {{0, 0, 0}};
+        for (const Vector &point : samples_)
+            for (int axis = 0; axis < 3; ++axis)
+                mean[axis] += point[axis] / samples_.size();
+        double matrix[4][5] = {};
+        for (const Vector &point : samples_) {
+            const double row[4] = {(point[0]-mean[0])/50,
+                                   (point[1]-mean[1])/50,
+                                   (point[2]-mean[2])/50, 1};
+            const double rhs = row[0]*row[0] + row[1]*row[1] + row[2]*row[2];
+            for (int i = 0; i < 4; ++i) {
+                for (int j = 0; j < 4; ++j)
+                    matrix[i][j] += row[i]*row[j];
+                matrix[i][4] += row[i]*rhs;
+            }
+        }
+        for (int col = 0; col < 4; ++col) {
+            int pivot = col;
+            for (int row = col+1; row < 4; ++row)
+                if (std::abs(matrix[row][col]) > std::abs(matrix[pivot][col]))
+                    pivot = row;
+            if (std::abs(matrix[pivot][col]) < samples_.size()*0.01)
+                return false; // stationary, planar or nearly singular
+            for (int j = col; j < 5; ++j)
+                std::swap(matrix[col][j], matrix[pivot][j]);
+            const double divisor = matrix[col][col];
+            for (int j = col; j < 5; ++j)
+                matrix[col][j] /= divisor;
+            for (int row = 0; row < 4; ++row) {
+                if (row == col)
+                    continue;
+                const double factor = matrix[row][col];
+                for (int j = col; j < 5; ++j)
+                    matrix[row][j] -= factor*matrix[col][j];
+            }
+        }
+        Vector offset;
+        double radiusSquared = matrix[3][4];
+        for (int axis = 0; axis < 3; ++axis) {
+            const double center = matrix[axis][4]/2;
+            offset[axis] = mean[axis] + center*50;
+            radiusSquared += center*center;
+        }
+        const double radius = std::sqrt(radiusSquared)*50;
+        if (!finite(offset) || norm(offset) > 1000 ||
+                !std::isfinite(radius) || radius < 20 || radius > 100)
+            return false;
+        Vector low = {{1, 1, 1}}, high = {{-1, -1, -1}};
+        double squaredError = 0;
+        for (const Vector &point : samples_) {
+            Vector delta;
+            for (int axis = 0; axis < 3; ++axis) {
+                delta[axis] = point[axis] - offset[axis];
+                low[axis] = std::min(low[axis], delta[axis]/radius);
+                high[axis] = std::max(high[axis], delta[axis]/radius);
+            }
+            const double error = (norm(delta)-radius)/radius;
+            if (std::abs(error) > 0.10)
+                return false;
+            squaredError += error*error;
+        }
+        for (int axis = 0; axis < 3; ++axis)
+            if (low[axis] > -0.65 || high[axis] < 0.65)
+                return false; // require both sides of all three axes
+        if (std::sqrt(squaredError/samples_.size()) > 0.04)
+            return false;
+        return restore(offset, radius);
+    }
+
+    bool valid_ = false;
+    Vector offset_ = {{0, 0, 0}};
+    double radius_ = 0;
+    unsigned sinceFit_ = 0;
+    std::vector<Vector> samples_;
+};
+#endif
