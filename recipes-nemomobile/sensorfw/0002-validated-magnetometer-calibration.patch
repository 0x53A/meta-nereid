+void CalibrationFilter::loadCalibration()
+{
+    if (calibrationFile.isEmpty())
+        return;
+    QFile file(calibrationFile);
+    if (!file.open(QIODevice::ReadOnly))
+        return;
+    const auto object = QJsonDocument::fromJson(file.read(4096)).object();
+    const auto offsets = object.value("offset").toArray();
+    if (object.value("version").toInt() != 1 ||
+            object.value("context").toString() != calibrationContext ||
+            offsets.size() != 3 || !object.value("radius").isDouble())
+        return;
+    HardIronCalibration::Vector offset;
+    for (int axis = 0; axis < 3; ++axis) {
+        if (!offsets[axis].isDouble())
+            return;
+        offset[axis] = offsets[axis].toDouble();
+    }
+    if (calibration.restore(offset, object.value("radius").toDouble()))
+        qCInfo(lcSensorFw) << "Loaded magnetometer hard-iron calibration";
+}
+
+void CalibrationFilter::saveCalibration()
+{
+    if (calibrationFile.isEmpty())
+        return;
+    QJsonArray offset;
+    for (double value : calibration.offset())
+        offset.append(value);
+    QJsonObject object;
+    object.insert("version", 1);
+    object.insert("context", calibrationContext);
+    object.insert("offset", offset);
+    object.insert("radius", calibration.radius());
+    const QByteArray bytes = QJsonDocument(object).toJson(QJsonDocument::Compact);
+    QSaveFile file(calibrationFile);
+    if (!QDir().mkpath(QFileInfo(calibrationFile).absolutePath()) ||
+            !file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit())
+        qCWarning(lcSensorFw) << "Failed to save magnetometer calibration:" << file.errorString();
+}
+
 void CalibrationFilter::dropCalibration()
 {
-    calLevel = 0;
-    minMaxList.clear();
+    calibration.reset();
+    lastTimestamp = 0;
+    if (!calibrationFile.isEmpty() && QFile::exists(calibrationFile) && !QFile::remove(calibrationFile))
+        qCWarning(lcSensorFw) << "Failed to remove saved magnetometer calibration";
 }
