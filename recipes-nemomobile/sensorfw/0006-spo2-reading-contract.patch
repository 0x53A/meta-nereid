--- a/sensors/spo2sensor/spo2sensor.cpp
+++ b/sensors/spo2sensor/spo2sensor.cpp
@@ -106,10 +106,14 @@
 
 void Spo2SensorChannel::emitData(const Spo2Data& value)
 {
-    if (value.percentage_ != previousValue_.percentage_ ||
-        value.confidence_ != previousValue_.confidence_ ||
-        value.status_ != previousValue_.status_) {
-        previousValue_ = value;
-        writeToClients((const void*)(&value), sizeof(value));
-    }
+    // Always replace the cached sample: raw readings and timestamps can
+    // change while the legacy integer fields remain equal.
+    previousValue_ = value;
+
+    // Keep the old socket ABI (TimedData + status + percentage + confidence)
+    // even though Spo2Data now carries internal raw contract fields.
+    Spo2LegacyData legacy(value.timestamp_, value.status_, value.percentage_, value.confidence_);
+    writeToClients((const void*)(&legacy), sizeof(legacy));
+    emit spo2Changed(Spo2(previousValue_));
+    emit spo2ReadingChanged(Spo2Reading(previousValue_));
 }
