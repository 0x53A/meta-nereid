--- a/datatypes/spo2.h
+++ b/datatypes/spo2.h
@@ -28,6 +28,63 @@
 #include <datatypes/spo2data.h>
 
 /**
+ * Raw LifeQ reading exposed alongside the established Spo2 (iii) property.
+ * The D-Bus structure is (tdddd): timestamp in monotonic microseconds,
+ * followed by vendor data[0..3] as doubles.
+ */
+class Spo2Reading
+{
+public:
+    Spo2Reading() : timestamp_(0), value_(0.0), confidence_(0.0), algorithm_(0.0), signal_(-1.0) {}
+    explicit Spo2Reading(const Spo2Data& data)
+        : timestamp_(data.timestamp_), value_(data.valueRaw_), confidence_(data.confidenceRaw_),
+          algorithm_(data.algorithmRaw_), signal_(data.signalRaw_) {}
+
+    quint64 timestamp() const { return timestamp_; }
+    double value() const { return value_; }
+    double confidence() const { return confidence_; }
+    double algorithm() const { return algorithm_; }
+    double signal() const { return signal_; }
+
+    bool operator==(const Spo2Reading& other) const
+    {
+        return timestamp_ == other.timestamp_ && value_ == other.value_ &&
+               confidence_ == other.confidence_ && algorithm_ == other.algorithm_ &&
+               signal_ == other.signal_;
+    }
+
+private:
+    quint64 timestamp_;
+    double value_;
+    double confidence_;
+    double algorithm_;
+    double signal_;
+
+    friend QDBusArgument& operator<<(QDBusArgument&, const Spo2Reading&);
+    friend const QDBusArgument& operator>>(const QDBusArgument&, Spo2Reading&);
+};
+
+Q_DECLARE_METATYPE(Spo2Reading)
+
+inline QDBusArgument& operator<<(QDBusArgument& argument, const Spo2Reading& reading)
+{
+    argument.beginStructure();
+    argument << reading.timestamp_ << reading.value_ << reading.confidence_
+             << reading.algorithm_ << reading.signal_;
+    argument.endStructure();
+    return argument;
+}
+
+inline const QDBusArgument& operator>>(const QDBusArgument& argument, Spo2Reading& reading)
+{
+    argument.beginStructure();
+    argument >> reading.timestamp_ >> reading.value_ >> reading.confidence_
+             >> reading.algorithm_ >> reading.signal_;
+    argument.endStructure();
+    return argument;
+}
+
+/**
  * QObject facade for #Spo2Data.
  */
 class Spo2 : public QObject
--- a/datatypes/spo2data.h
+++ b/datatypes/spo2data.h
@@ -26,6 +26,8 @@
 
 #include "datatypes/genericdata.h"
 
+#include <cmath>
+
 enum Spo2Status {
     Spo2NoContact,
     Spo2Unreliable,
@@ -34,15 +36,66 @@
     Spo2AccuracyHigh
 };
 
+enum Spo2Signal {
+    Spo2SignalOk = 0,
+    Spo2SignalNoSignal = 1,
+    Spo2SignalLowSnr = 2,
+    Spo2SignalLowPerfusion = 4,
+    Spo2SignalMovement = 8,
+    Spo2SignalTight = 10,
+    Spo2SignalLoose = 20,
+    Spo2SignalBounds = 40,
+    Spo2SignalUnknown = -1
+};
+
+/* Matches the accepted-result contract used by the stock Hoki consumer:
+ * FINAL, clear signal, integer oxygen strictly above 80, and integer
+ * confidence at least 80. The finite/range checks keep malformed HAL data
+ * from reaching the legacy integer ABI. */
+inline bool spo2IsValidFinal(double value, double confidence,
+                             double algorithm, double signal)
+{
+    if (!std::isfinite(value) || !std::isfinite(confidence) ||
+        !std::isfinite(algorithm) || !std::isfinite(signal))
+        return false;
+    if (value < 0.0 || value > 100.0 || confidence < 0.0 || confidence > 100.0)
+        return false;
+    if (algorithm < 0.0 || algorithm > 5.0 || algorithm != std::floor(algorithm))
+        return false;
+    return algorithm == 5.0 && signal == Spo2SignalOk &&
+           static_cast<int>(value) > 80 && static_cast<int>(confidence) >= 80;
+}
+
+/* Exact record sent to legacy sensorfw socket consumers. Keep this layout
+ * independent of Spo2Data's internal raw fields. */
+class Spo2LegacyData : public TimedData {
+public:
+    Spo2LegacyData(const quint64& timestamp, Spo2Status status, int percentage, int confidence)
+        : TimedData(timestamp), status_(status), percentage_(percentage), confidence_(confidence) {}
+
+    Spo2Status status_;
+    int percentage_;
+    int confidence_;
+};
+
 class Spo2Data : public TimedData {
 public:
-    Spo2Data() : TimedData(0), status_(Spo2NoContact), percentage_(0), confidence_(0) {}
+    Spo2Data() : TimedData(0), status_(Spo2NoContact), percentage_(0), confidence_(0),
+        valueRaw_(0.0), confidenceRaw_(0.0), algorithmRaw_(0.0), signalRaw_(-1.0) {}
     Spo2Data(const quint64& timestamp, Spo2Status status, int percentage, int confidence)
-        : TimedData(timestamp), status_(status), percentage_(percentage), confidence_(confidence) {}
+        : TimedData(timestamp), status_(status), percentage_(percentage), confidence_(confidence),
+          valueRaw_(percentage), confidenceRaw_(confidence), algorithmRaw_(0.0), signalRaw_(-1.0) {}
 
     Spo2Status status_;
     int percentage_;  // SpO2 percentage (0-100)
     int confidence_;  // Confidence percentage (0-100)
+
+    // Raw LifeQ contract fields. These are internal pipeline state; the
+    // legacy socket record remains Spo2LegacyData above.
+    double valueRaw_;
+    double confidenceRaw_;
+    double algorithmRaw_;
+    double signalRaw_;
 };
 
 #endif // SPO2DATA_H
