--- /dev/null
+++ b/tests/spo2contracttest.cpp
@@ -0,0 +1,63 @@
+/*
+ * Small ABI/contract regression helper. Build manually from a patched source
+ * tree after datatypes: cd tests && qmake6 spo2contracttest.pro && make.
+ */
+#include <QByteArray>
+#include <QDBusMetaType>
+#include <limits>
+#include <cstring>
+
+#include "datatypes/spo2.h"
+
+int main()
+{
+    Spo2Data data(123456789ULL, Spo2AccuracyHigh, 97, 88);
+    data.valueRaw_ = 97.25;
+    data.confidenceRaw_ = 88.5;
+    data.algorithmRaw_ = 5.0;
+    data.signalRaw_ = 0.0;
+
+    qDBusRegisterMetaType<Spo2Reading>();
+    qDBusRegisterMetaType<Spo2>();
+    if (QByteArray(QDBusMetaType::typeToSignature(QMetaType::fromType<Spo2Reading>())) != "(tdddd)")
+        return 1;
+    if (QByteArray(QDBusMetaType::typeToSignature(QMetaType::fromType<Spo2>())) != "(iii)")
+        return 1;
+
+    const Spo2Reading raw(data);
+    if (raw.timestamp() != 123456789ULL || raw.value() != 97.25 ||
+        raw.confidence() != 88.5 || raw.algorithm() != 5.0 || raw.signal() != 0.0)
+        return 1;
+
+    if (!spo2IsValidFinal(97.25, 88.5, 5.0, 0.0) ||
+        spo2IsValidFinal(80.25, 88.5, 5.0, 0.0) ||
+        spo2IsValidFinal(97.25, 88.5, 4.0, 0.0) ||
+        spo2IsValidFinal(97.25, 88.5, 5.0, 8.0) ||
+        spo2IsValidFinal(std::numeric_limits<double>::quiet_NaN(), 88.5, 5.0, 0.0) ||
+        spo2IsValidFinal(97.25, 88.5, 5.0, 1.0))
+        return 1;
+
+    struct HistoricalSpo2Wire {
+        quint64 timestamp_;
+        Spo2Status status_;
+        int percentage_;
+        int confidence_;
+    };
+    static_assert(sizeof(Spo2LegacyData) == sizeof(HistoricalSpo2Wire));
+    Spo2LegacyData legacy(data.timestamp_, data.status_, data.percentage_, data.confidence_);
+    HistoricalSpo2Wire wire{};
+    std::memcpy(&wire, &legacy, sizeof(wire));
+    if (wire.timestamp_ != legacy.timestamp_ || wire.status_ != legacy.status_ ||
+        wire.percentage_ != legacy.percentage_ || wire.confidence_ != legacy.confidence_ ||
+        sizeof(Spo2LegacyData) >= sizeof(Spo2Data))
+        return 1;
+
+    Spo2Data sameLegacyDifferentRaw(123456790ULL, Spo2AccuracyHigh, 97, 88);
+    sameLegacyDifferentRaw.valueRaw_ = 97.5;
+    sameLegacyDifferentRaw.confidenceRaw_ = 88.25;
+    sameLegacyDifferentRaw.algorithmRaw_ = 5.0;
+    sameLegacyDifferentRaw.signalRaw_ = 0.0;
+    if (Spo2Reading(data) == Spo2Reading(sameLegacyDifferentRaw))
+        return 1;
+    return 0;
+}
