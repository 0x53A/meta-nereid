diff --git a/core/hybriscontrolresult.h b/core/hybriscontrolresult.h
new file mode 100644
--- /dev/null
+++ b/core/hybriscontrolresult.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_CONTROL_RESULT_H
+#define HYBRIS_CONTROL_RESULT_H
+
+#include <cerrno>
+#include <cstdint>
+
+// The caller owns the reply. Never translate transport/decoding failure to 0:
+// HybrisManager commits its cached activation/rate only on a zero return value.
+template<typename ReadInt32>
+int hybrisControlResult(int transportStatus, bool hasReply, ReadInt32 read)
+{
+    if (transportStatus != 0 || !hasReply)
+        return -EIO;
+    int32_t exception = 0;
+    int32_t result = 0;
+    if (!read(&exception) || exception != 0 || !read(&result))
+        return -EPROTO;
+    return result;
+}
+
+#endif
diff --git a/core/hybrisrecordingdemand.h b/core/hybrisrecordingdemand.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrecordingdemand.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_RECORDING_DEMAND_H
+#define HYBRIS_RECORDING_DEMAND_H
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+
+struct HybrisRecordingDemand {
+    bool active = false;
+    int64_t periodNs = 0;
+    int64_t latencyNs = 0;
+};
+
+// One instance per physical handle, confined to the HAL owner's thread.
+// Callers supply validated rates in ns (never manager rates in microseconds).
+class HybrisRecordingArbiter {
+public:
+    enum Owner { Ui, Recorder };
+    const HybrisRecordingDemand &applied() const { return m_applied; }
+    bool healthy() const { return m_healthy; }
+    HybrisRecordingDemand request(Owner owner) const
+    { return owner == Ui ? m_ui : m_recorder; }
+
+    // Construct only after hardware has been confirmed inactive. Reconstruct
+    // after reconnect; this object must not outlive its HAL connection.
+    explicit HybrisRecordingArbiter(bool batchable = true)
+        : m_batchable(batchable) {}
+
+    // Attach to an already managed handle without changing its hardware state.
+    HybrisRecordingArbiter(bool batchable, HybrisRecordingDemand currentUi)
+        : m_batchable(batchable), m_ui(currentUi), m_applied(currentUi) {}
+
+    template<typename Batch, typename Activate>
+    int update(Owner owner, HybrisRecordingDemand request, Batch batch, Activate activate)
+    {
+        if (!m_healthy)
+            return -EIO;
+        if (request.active && (request.latencyNs < 0 ||
+            (m_batchable && request.periodNs < 0)))
+            return -EINVAL;
+        HybrisRecordingDemand ui = m_ui, recorder = m_recorder;
+        (owner == Ui ? ui : recorder) = request;
+        HybrisRecordingDemand target = merge(ui, recorder);
+        const bool rateChange = m_batchable && target.active &&
+            (!m_applied.active || target.periodNs != m_applied.periodNs ||
+             target.latencyNs != m_applied.latencyNs);
+        const bool activationChange = target.active != m_applied.active;
+        int error = 0;
+        if (rateChange)
+            error = batch(target.periodNs, target.latencyNs);
+        if (!error && activationChange)
+            error = activate(target.active);
+        if (error) {
+            // A failed RPC can have reached the hardware. Reassert the previous
+            // state, including on batch failure, before accepting more requests.
+            int restoreRate = 0;
+            if (m_batchable && m_applied.active)
+                restoreRate = batch(m_applied.periodNs, m_applied.latencyNs);
+            int restoreActive = activate(m_applied.active);
+            if (restoreRate || restoreActive)
+                m_healthy = false;
+            return error;
+        }
+        m_ui = ui;
+        m_recorder = recorder;
+        m_applied = target;
+        return 0;
+    }
+
+private:
+    static HybrisRecordingDemand merge(HybrisRecordingDemand ui,
+                                       HybrisRecordingDemand recorder)
+    {
+        if (!ui.active)
+            return recorder.active ? recorder : HybrisRecordingDemand{};
+        if (!recorder.active)
+            return ui;
+        ui.periodNs = std::min(ui.periodNs, recorder.periodNs);
+        ui.latencyNs = std::min(ui.latencyNs, recorder.latencyNs);
+        return ui;
+    }
+    bool m_batchable;
+    bool m_healthy = true;
+    HybrisRecordingDemand m_ui, m_recorder, m_applied;
+};
+
+#endif
diff --git a/core/hybrisrawqueue.h b/core/hybrisrawqueue.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrawqueue.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_RAW_QUEUE_H
+#define HYBRIS_RAW_QUEUE_H
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+// Confined to the HAL owner's thread. Storage is allocated once, before sensor
+// activation. The poll path never allocates, blocks on disk, or replaces unread
+// records. A consumer must persist counters and inspect sequence discontinuity.
+class HybrisRawQueue {
+public:
+    struct Record {
+        uint64_t sequence = 0;
+        std::array<unsigned char, 88> wire{};
+    };
+    explicit HybrisRawQueue(std::size_t capacity)
+        : m_slots(checkedCapacity(capacity)) {}
+
+    bool push(int64_t arrivalNs, const void *event80)
+    {
+        const uint64_t sequence = m_received++;
+        if (m_count == m_slots.size()) {
+            ++m_dropped;
+            return false;
+        }
+        Record &record = m_slots[(m_head + m_count) % m_slots.size()];
+        record.sequence = sequence;
+        const uint64_t arrival = static_cast<uint64_t>(arrivalNs);
+        for (unsigned i = 0; i < 8; ++i)
+            record.wire[i] = static_cast<unsigned char>(arrival >> (8 * i));
+        std::memcpy(record.wire.data() + 8, event80, 80);
+        ++m_count;
+        return true;
+    }
+
+    // Peek/consume, rather than destructive pop, lets a writer retain the batch
+    // until its write succeeds. consume does not mean durable storage.
+    const Record *front() const { return m_count ? &m_slots[m_head] : nullptr; }
+    bool consume(uint64_t sequence)
+    {
+        if (!m_count || m_slots[m_head].sequence != sequence)
+            return false;
+        m_head = (m_head + 1) % m_slots.size();
+        --m_count;
+        return true;
+    }
+    std::size_t size() const { return m_count; }
+    uint64_t received() const { return m_received; }
+    uint64_t dropped() const { return m_dropped; }
+    uint64_t inputFailures() const { return m_inputFailures; }
+    void noteInputFailure() { ++m_inputFailures; }
+    bool complete() const { return !m_dropped && !m_inputFailures; }
+
+private:
+    static std::size_t checkedCapacity(std::size_t capacity)
+    {
+        if (!capacity || capacity > 65536)
+            throw std::invalid_argument("raw queue capacity must be 1..65536");
+        return capacity;
+    }
+    std::vector<Record> m_slots;
+    std::size_t m_head = 0, m_count = 0;
+    uint64_t m_received = 0, m_dropped = 0, m_inputFailures = 0;
+};
+
+#endif
diff --git a/core/hybrisrawstorage.h b/core/hybrisrawstorage.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrawstorage.h
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_RAW_STORAGE_H
+#define HYBRIS_RAW_STORAGE_H
+
+#include "hybrisrawqueue.h"
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+#include <cerrno>
+#include <cstdio>
+#include <string>
+#include <system_error>
+
+// Single storage-thread owner. Never call from the HAL poll callback.
+// A failed write poisons this instance: retrying could duplicate a partial record.
+class HybrisRawStorage {
+    struct Fd {
+        int value = -1;
+        explicit Fd(int fd = -1) : value(fd) {}
+        ~Fd() { if (value >= 0) ::close(value); }
+        Fd(const Fd &) = delete;
+        Fd &operator=(const Fd &) = delete;
+    };
+public:
+    HybrisRawStorage(const std::string &directory, const std::string &identity,
+                     uint64_t segmentLimit, uint64_t totalLimit, uint64_t reserveBytes = 0)
+        : m_dir(::open(directory.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)),
+          m_segmentLimit(segmentLimit), m_totalLimit(totalLimit), m_reserveBytes(reserveBytes)
+    {
+        if (segmentLimit < 104 || totalLimit < segmentLimit)
+            fail(EINVAL, "storage limits");
+        check(m_dir.value, "open capture directory");
+        requireSpace(totalLimit); // Admission check, not a filesystem reservation.
+        Fd marker(create("session"));
+        writeAll(marker.value, identity.data(), identity.size());
+        sync(marker.value);
+        syncParents();
+        openSegment();
+    }
+
+    void append(const HybrisRawQueue::Record &record)
+    {
+        healthy();
+        if (m_final) fail(EPIPE, "capture already finalized");
+        if (m_haveSequence && record.sequence <= m_lastSequence)
+            fail(EINVAL, "duplicate or regressing sequence");
+        const bool rotate = m_segmentBytes + 88 > m_segmentLimit;
+        const uint64_t needed = 88 + (rotate ? 16 : 0);
+        if (needed > m_totalLimit - m_totalBytes)
+            fail(ENOSPC, "capture byte limit reached");
+        if (rotate) {
+            requireSpace(needed);
+            sync(m_file.value);
+            int old = m_file.value;
+            m_file.value = -1;
+            check(::close(old), "close segment");
+            ++m_segment;
+            openSegment();
+        }
+        writeAll(m_file.value, record.wire.data(), record.wire.size());
+        m_missing += m_haveSequence ? record.sequence - m_lastSequence - 1 : record.sequence;
+        m_haveSequence = true;
+        m_lastSequence = record.sequence;
+        m_segmentBytes += 88;
+        m_totalBytes += 88;
+        ++m_records;
+    }
+
+    // Returns whether this durable checkpoint has no reported capture loss.
+    // HAL flush completion and drain boundaries must be established by caller.
+    bool checkpoint(uint64_t dropped, uint64_t inputFailures, bool final = false)
+    {
+        healthy();
+        if (m_final) fail(EPIPE, "capture already finalized");
+        if (dropped < m_dropped || inputFailures < m_inputFailures)
+            fail(EINVAL, "loss counters regressed");
+        m_dropped = dropped;
+        m_inputFailures = inputFailures;
+        sync(m_file.value);
+        const bool complete = !dropped && !inputFailures && !m_missing;
+        std::string json = "{\"version\":1,\"generation\":" + std::to_string(++m_generation) +
+            ",\"segment\":" + std::to_string(m_segment) +
+            ",\"segment_bytes\":" + std::to_string(m_segmentBytes) +
+            ",\"total_bytes\":" + std::to_string(m_totalBytes) +
+            ",\"records\":" + std::to_string(m_records) +
+            ",\"sequence_missing\":" + std::to_string(m_missing) +
+            ",\"dropped\":" + std::to_string(dropped) +
+            ",\"input_failures\":" + std::to_string(inputFailures) +
+            ",\"complete\":" + (complete ? "true" : "false") +
+            ",\"final\":" + (final ? "true" : "false") + "}\n";
+        Fd temp(create("checkpoint.tmp"));
+        writeAll(temp.value, json.data(), json.size());
+        sync(temp.value);
+        check(::renameat(m_dir.value, "checkpoint.tmp", m_dir.value, "checkpoint.json"), "rename checkpoint");
+        sync(m_dir.value);
+        m_final = final;
+        return complete;
+    }
+
+private:
+    [[noreturn]] void fail(int error, const char *what)
+    {
+        m_failed = true;
+        throw std::system_error(error, std::generic_category(), what);
+    }
+    void healthy() { if (m_failed) fail(EIO, "storage is failed"); }
+    int check(int result, const char *what)
+    { if (result < 0) fail(errno, what); return result; }
+    int create(const char *name)
+    { return check(::openat(m_dir.value, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600), "create capture file"); }
+    void sync(int fd) { check(::fsync(fd), "sync capture"); }
+    void writeAll(int fd, const void *data, std::size_t size)
+    {
+        requireSpace(size);
+        const char *bytes = static_cast<const char *>(data);
+        while (size) {
+            ssize_t n = ::write(fd, bytes, size);
+            if (n < 0 && errno == EINTR) continue;
+            if (n <= 0) fail(n < 0 ? errno : EIO, "write capture");
+            bytes += n;
+            size -= n;
+        }
+    }
+    void requireSpace(uint64_t bytes)
+    {
+        if (!m_reserveBytes) return; // Explicit low-level opt-out for legacy callers.
+        struct statvfs space;
+        check(::fstatvfs(m_dir.value, &space), "query capture free space");
+        const uint64_t block = space.f_frsize;
+        if (!block) fail(EIO, "invalid filesystem allocation unit");
+        // Work in allocation units to avoid overflow and account conservatively
+        // for partial blocks. Headroom covers small metadata/checkpoint writes.
+        const auto units = [block](uint64_t size) {
+            return size / block + (size % block != 0);
+        };
+        uint64_t available = space.f_bavail;
+        for (uint64_t needed : {units(m_reserveBytes), units(bytes), units(65536)}) {
+            if (needed > available) fail(ENOSPC, "capture free-space reserve reached");
+            available -= needed;
+        }
+        // Other filesystem writers can race this check. Actual write/fsync
+        // errors still poison storage; this is not a quota or hard reservation.
+    }
+    void syncParents()
+    {
+        Fd current(check(::dup(m_dir.value), "dup directory"));
+        for (;;) {
+            sync(current.value);
+            Fd parent(check(::openat(current.value, "..", O_RDONLY | O_DIRECTORY | O_CLOEXEC), "open parent"));
+            struct stat here, above;
+            check(::fstat(current.value, &here), "stat directory");
+            check(::fstat(parent.value, &above), "stat parent");
+            if (here.st_dev == above.st_dev && here.st_ino == above.st_ino) break;
+            int old = current.value;
+            current.value = -1;
+            check(::close(old), "close directory");
+            current.value = parent.value;
+            parent.value = -1;
+        }
+    }
+    void openSegment()
+    {
+        char name[48];
+        std::snprintf(name, sizeof name, "events-%06llu.bin", static_cast<unsigned long long>(m_segment));
+        m_file.value = create(name);
+        const unsigned char header[16] = {'H','O','K','I','S','E','N','1',88,0,0,0,1,0,0,0};
+        writeAll(m_file.value, header, sizeof header);
+        m_segmentBytes = sizeof header;
+        m_totalBytes += sizeof header;
+    }
+    Fd m_dir, m_file;
+    uint64_t m_segmentLimit, m_totalLimit, m_reserveBytes;
+    uint64_t m_segment = 0, m_segmentBytes = 0, m_totalBytes = 0;
+    uint64_t m_records = 0, m_lastSequence = 0, m_missing = 0, m_generation = 0;
+    uint64_t m_dropped = 0, m_inputFailures = 0;
+    bool m_haveSequence = false, m_failed = false, m_final = false;
+};
+
+#endif
