+#include <sys/eventfd.h>
+
+// One producer (HAL owner) and one disk worker. Neither queue mutation nor
+// status reads wait for disk I/O. Connect notificationFd() to QSocketNotifier.
+class HybrisStorageWorker {
+    struct Job {
+        HybrisRawQueue::Record record;
+        uint64_t token = 0, dropped = 0, failures = 0;
+        bool final = false;
+    };
+public:
+    HybrisStorageWorker(std::string directory, std::string identity,
+                        uint64_t segmentLimit, uint64_t totalLimit, size_t capacity,
+                        uint64_t reserveBytes = 0)
+        : m_jobs(checkedCapacity(capacity)),
+          m_notify(::eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC))
+    {
+        if (m_notify < 0)
+            throw std::system_error(errno, std::generic_category(), "storage eventfd");
+        try {
+            m_thread = std::thread([this, directory, identity, segmentLimit, totalLimit, reserveBytes] {
+                run(directory, identity, segmentLimit, totalLimit, reserveBytes);
+            });
+        } catch (...) {
+            ::close(m_notify);
+            throw;
+        }
+    }
+    ~HybrisStorageWorker()
+    {
+        { std::lock_guard<std::mutex> lock(m_mutex); m_stop = true; }
+        m_condition.notify_one();
+        m_thread.join(); // Orderly drain; does not imply a final checkpoint.
+        ::close(m_notify);
+    }
+    HybrisStorageWorker(const HybrisStorageWorker &) = delete;
+    HybrisStorageWorker &operator=(const HybrisStorageWorker &) = delete;
+    int notificationFd() const { return m_notify; }
+    int status() const { return m_status.load(); } // 0 starting,1 ready,negative errno.
+    uint64_t completion() const { return m_completion.load(); } // token<<1 | complete
+    // Monotonic counts, not an authorization to suspend. Later records may be
+    // submitted after a checkpoint completes; only its saved prefix is durable.
+    uint64_t durableRecords() const { return m_durableRecords.load(); }
+    uint64_t submittedRecords() const { return m_submittedRecords.load(); }
+    void clearNotification()
+    {
+        uint64_t value;
+        while (::read(m_notify, &value, sizeof value) < 0 && errno == EINTR) {}
+    }
+    bool submit(const HybrisRawQueue::Record &record)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_stop || status() != 1 || m_count == m_jobs.size() ||
+            m_submittedRecords.load() == UINT64_MAX) return false;
+        Job &job = m_jobs[(m_head + m_count) % m_jobs.size()];
+        job.record = record;
+        job.token = 0;
+        ++m_count;
+        ++m_submittedRecords;
+        m_condition.notify_one();
+        return true;
+    }
+    // One pending checkpoint prevents unbounded completion bookkeeping. A
+    // nonzero token means queued, never durable; wait for completion().
+    uint64_t checkpoint(uint64_t dropped, uint64_t failures, bool final = false)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_stop || status() != 1 || m_count == m_jobs.size() ||
+            (completion() >> 1) != m_lastToken || m_lastToken == UINT64_MAX / 2)
+            return 0;
+        Job &job = m_jobs[(m_head + m_count) % m_jobs.size()];
+        job.token = ++m_lastToken;
+        job.dropped = dropped;
+        job.failures = failures;
+        job.final = final;
+        ++m_count;
+        m_condition.notify_one();
+        return m_lastToken;
+    }
+
+private:
+    static size_t checkedCapacity(size_t capacity)
+    {
+        if (!capacity || capacity > 65536)
+            throw std::invalid_argument("worker capacity must be 1..65536");
+        return capacity;
+    }
+    void notify()
+    {
+        const uint64_t one = 1;
+        while (::write(m_notify, &one, sizeof one) < 0 && errno == EINTR) {}
+        // EAGAIN means the eventfd is already readable; no wake is lost.
+    }
+    void run(const std::string &directory, const std::string &identity,
+             uint64_t segmentLimit, uint64_t totalLimit, uint64_t reserveBytes)
+    {
+        try {
+            HybrisRawStorage storage(directory, identity, segmentLimit, totalLimit, reserveBytes);
+            m_status.store(1);
+            notify();
+            uint64_t writtenRecords = 0;
+            for (;;) {
+                Job job;
+                bool wasFull;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_condition.wait(lock, [this] { return m_stop || m_count; });
+                    if (!m_count && m_stop) return;
+                    wasFull = m_count == m_jobs.size();
+                    job = m_jobs[m_head];
+                    m_head = (m_head + 1) % m_jobs.size();
+                    --m_count;
+                }
+                if (wasFull) notify(); // Resume a producer that hit the bound.
+                if (job.token) {
+                    bool complete = storage.checkpoint(job.dropped, job.failures, job.final);
+                    // checkpoint() includes data, metadata and directory fsync.
+                    // A failed/incomplete checkpoint must not advance this.
+                    if (complete) m_durableRecords.store(writtenRecords);
+                    m_completion.store((job.token << 1) | (complete ? 1 : 0));
+                    notify();
+                } else {
+                    storage.append(job.record);
+                    ++writtenRecords;
+                }
+            }
+        } catch (const std::system_error &error) {
+            m_status.store(-std::max(1, error.code().value()));
+        } catch (...) {
+            m_status.store(-EIO);
+        }
+        notify();
+    }
+    std::vector<Job> m_jobs;
+    int m_notify;
+    std::mutex m_mutex;
+    std::condition_variable m_condition;
+    std::thread m_thread;
+    size_t m_head = 0, m_count = 0;
+    bool m_stop = false;
+    uint64_t m_lastToken = 0;
+    std::atomic<int> m_status{0};
+    std::atomic<uint64_t> m_completion{0};
+    std::atomic<uint64_t> m_submittedRecords{0}, m_durableRecords{0};
+};
+
+#endif
diff --git a/core/hybrisrecordingsocket.h b/core/hybrisrecordingsocket.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrecordingsocket.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_RECORDING_SOCKET_H
+#define HYBRIS_RECORDING_SOCKET_H
+#include <QLocalServer>
+#include <QLocalSocket>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QFileInfo>
+#include <QTimer>
+#include <functional>
+#include <cerrno>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+// One bounded JSON request/reply per connection, protected by a private parent
+// directory and owner-only socket permissions. No networking transport.
+class HybrisRecordingSocket {
+public:
+    using Handler = std::function<QJsonObject(const QJsonObject &)>;
+    ~HybrisRecordingSocket()
+    {
+        m_server.close();
+        if (m_lock >= 0) ::close(m_lock);
+    }
+    bool listen(const QString &path, Handler handler)
+    {
+        if (m_lock >= 0) return false;
+        const QByteArray parent = QFileInfo(path).absolutePath().toLocal8Bit();
+        struct stat st;
+        if (!QFileInfo(path).isAbsolute() || ::lstat(parent.constData(), &st) ||
+            !S_ISDIR(st.st_mode) || st.st_uid != ::geteuid() || (st.st_mode & 0077))
+            return false;
+        const auto localPath = path.toLocal8Bit();
+        const auto lockPath = localPath + ".lock";
+        m_lock = ::open(lockPath.constData(), O_RDWR | O_CREAT | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC, 0600);
+        if (m_lock < 0) return false;
+        if (::fstat(m_lock, &st) || !S_ISREG(st.st_mode) || ::flock(m_lock, LOCK_EX | LOCK_NB) ||
+            ::lstat(localPath.constData(), &st) == 0 || errno != ENOENT) {
+            ::close(m_lock); m_lock = -1; return false;
+        }
+        m_server.setSocketOptions(QLocalServer::UserAccessOption);
+        m_server.setMaxPendingConnections(4);
+        QObject::connect(&m_server, &QLocalServer::newConnection, &m_server, [this, handler] {
+            while (auto *socket = m_server.nextPendingConnection()) {
+                if (m_clients >= 4) { socket->abort(); socket->deleteLater(); continue; }
+                ++m_clients;
+                socket->setParent(&m_server);
+                socket->setReadBufferSize(8193);
+                QObject::connect(socket, &QLocalSocket::disconnected, &m_server, [this, socket] {
+                    --m_clients; socket->deleteLater();
+                });
+                QTimer::singleShot(5000, socket, [socket] { socket->abort(); });
+                QObject::connect(socket, &QLocalSocket::readyRead, socket,
+                    [socket, handler, buffer = QByteArray(), handled = false]() mutable {
+                        if (handled) return;
+                        buffer += socket->read(8193 - buffer.size());
+                        if (buffer.size() > 8192) { socket->abort(); return; }
+                        int newline = buffer.indexOf('\n');
+                        if (newline < 0) return;
+                        handled = true;
+                        QJsonParseError error;
+                        auto document = QJsonDocument::fromJson(buffer.left(newline), &error);
+                        QJsonObject reply;
+                        if (error.error != QJsonParseError::NoError || !document.isObject())
+                            reply = QJsonObject{{"error", -EINVAL}};
+                        else
+                            reply = handler(document.object());
+                        socket->write(QJsonDocument(reply).toJson(QJsonDocument::Compact) + '\n');
+                        socket->disconnectFromServer();
+                    });
+                if (socket->bytesAvailable())
+                    QMetaObject::invokeMethod(socket, "readyRead", Qt::QueuedConnection);
+            }
+        });
+        return m_server.listen(path); // Never unlink an existing server socket.
+    }
+private:
+    QLocalServer m_server;
+    unsigned m_clients = 0;
+    int m_lock = -1;
+};
+#endif
diff --git a/core/hybrisrecordingwakeguard.h b/core/hybrisrecordingwakeguard.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrecordingwakeguard.h
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef HYBRIS_RECORDING_WAKE_GUARD_H
+#define HYBRIS_RECORDING_WAKE_GUARD_H
+
+#include <cerrno>
+#include <cstdint>
+#include <fcntl.h>
+#include <unistd.h>
+
+// Confined to the HAL/control owner thread. Acquire before accepting a batch;
+// keep held until every received record is certified durable. The suspend
+// controller MUST also use the kernel wakeup_count handshake, with a bounded
+// supervisor: writing mem directly does not honor this contract.
+//
+// No timeout silently releases unsaved data. A service ExecStopPost must unlock
+// the fixed name after abnormal process death; closing these fds is not unlock.
+class HybrisRecordingWakeGuard {
+public:
+    explicit HybrisRecordingWakeGuard(const char *lockPath = "/sys/power/wake_lock",
+                                      const char *unlockPath = "/sys/power/wake_unlock")
+    {
+        m_lock = ::open(lockPath, O_WRONLY | O_CLOEXEC);
+        if (m_lock < 0) { m_error = -errno; return; }
+        m_unlock = ::open(unlockPath, O_WRONLY | O_CLOEXEC);
+        if (m_unlock < 0) m_error = -errno;
+    }
+    ~HybrisRecordingWakeGuard()
+    {
+        // Orderly destruction terminates the recording contract. Callers must
+        // finalize/mark incomplete before destroying; this is not a checkpoint.
+        if (m_maybeHeld && m_unlock >= 0) writeName(m_unlock);
+        if (m_unlock >= 0) ::close(m_unlock);
+        if (m_lock >= 0) ::close(m_lock);
+    }
+    HybrisRecordingWakeGuard(const HybrisRecordingWakeGuard &) = delete;
+    HybrisRecordingWakeGuard &operator=(const HybrisRecordingWakeGuard &) = delete;
+    int error() const { return m_error; }
+    bool held() const { return m_held; }
+    int acquire()
+    {
+        if (m_terminated) return -ESHUTDOWN;
+        if (m_error) return m_error;
+        if (m_held) return 0;
+        m_maybeHeld = true; // An interrupted/short write may have acted.
+        const int result = writeName(m_lock);
+        if (result) return m_error = result;
+        m_held = true;
+        return 0;
+    }
+    // Returns -EAGAIN until idle and healthy. Caller must supply all received
+    // records, including those not yet submitted to the disk worker.
+    int releaseIfDurable(uint64_t received, uint64_t durable, bool healthy,
+                         bool controlPending)
+    {
+        if (m_terminated) return -ESHUTDOWN;
+        if (m_error) return m_error;
+        if (!healthy || controlPending || durable != received) return -EAGAIN;
+        if (!m_held) return 0;
+        const int result = writeName(m_unlock);
+        if (result) return m_error = result;
+        m_held = m_maybeHeld = false;
+        return 0;
+    }
+    // Explicit failed-session teardown, never a durability acknowledgement.
+    // Caller must stop accepting input and latch failure first. Retire this
+    // guard permanently so later poll callbacks cannot reacquire the hold.
+    int releaseForTerminatedCapture()
+    {
+        m_terminated = true;
+        if (!m_maybeHeld) return 0;
+        const int result = m_unlock >= 0 ? writeName(m_unlock) : -EBADF;
+        if (result) return m_error = result;
+        m_held = m_maybeHeld = false;
+        return 0;
+    }
+private:
+    static int writeName(int fd)
+    {
+        static const char name[] = "sensorfwd_recording\n";
+        // sysfs write is one transaction. Never retry a partial suffix as a
+        // new command or assume an ambiguous failure left the lock unchanged.
+        const ssize_t result = ::write(fd, name, sizeof name - 1);
+        return result == sizeof name - 1 ? 0 : (result < 0 ? -errno : -EIO);
+    }
+    int m_lock = -1, m_unlock = -1, m_error = 0;
+    bool m_held = false, m_maybeHeld = false, m_terminated = false;
+};
+
+#endif
diff --git a/core/hybrisrecordingowner.h b/core/hybrisrecordingowner.h
new file mode 100644
--- /dev/null
+++ b/core/hybrisrecordingowner.h
@@ -0,0 +1,28 @@
+#ifndef HYBRIS_RECORDING_OWNER_H
+#define HYBRIS_RECORDING_OWNER_H
+#include <string>
+
+// Guards against accidentally changing another root controller's session.
+// This is not authentication against a privileged adversary.
+class HybrisRecordingOwner {
+public:
+    static bool valid(const std::string &token) {
+        if (token.size() != 36) return false;
+        for (unsigned i=0; i<token.size(); ++i) {
+            if (i==8 || i==13 || i==18 || i==23) {
+                if (token[i]!='-') return false;
+            } else if (!((token[i]>='0' && token[i]<='9') ||
+                         (token[i]>='a' && token[i]<='f'))) return false;
+        }
+        return true;
+    }
+    void assign(const std::string &token) { m_token=token; }
+    void clear() { m_token.clear(); }
+    bool accepts(const std::string &supplied) const {
+        return m_token.empty() || supplied==m_token;
+    }
+    const std::string &token() const { return m_token; }
+private:
+    std::string m_token;
+};
+#endif
