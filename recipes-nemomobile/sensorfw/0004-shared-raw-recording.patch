+int HybrisBackendBinderHidl::updateDemand(int handle, HybrisRecordingArbiter::Owner owner,
+                                         HybrisRecordingDemand request)
+{
+    auto it = m_recordingDemands.find(handle);
+    if (it == m_recordingDemands.end())
+        return -EINVAL;
+    return it->second.update(owner, request,
+        [this, handle](int64_t period, int64_t latency) {
+            return batchHardware(handle, period, latency);
+        }, [this, handle](bool active) { return activateHardware(handle, active); });
+}
+
+int HybrisBackendBinderHidl::setRecordingDemand(int handle, bool active,
+                                              int64_t periodNs, int64_t latencyNs)
+{
+    // FMQ ownership/wake acknowledgements require a separate integration.
+    if (m_sensorInterfaceEnum != SENSOR_INTERFACE_1_0)
+        return -ENOTSUP;
+    if (active && !m_rawRecording)
+        return -EINVAL;
+    if (active && m_stopRequested)
+        return -ESHUTDOWN;
+    if (active && (!m_rawRecording->complete() || m_recordingFlushFailed))
+        return -EIO;
+    if (active && holdRecordingWake())
+        return -EIO;
+    if (active && m_storageWorker && m_storageWorker->status() != 1)
+        return m_storageWorker->status() < 0 ? -EIO : -EAGAIN;
+    int index = m_manager->indexForHandle(handle);
+    if (index < 0 || !m_client)
+        return -EINVAL;
+    const sensor_t &sensor = m_sensorArray[index];
+    const bool batchable = ((sensor.flags >> 1) & 7) != 2;
+    if (active && (latencyNs < 0 || periodNs < 0 ||
+        (batchable && sensor.minDelay > 0 && periodNs < int64_t(sensor.minDelay) * 1000) ||
+        (batchable && sensor.maxDelay > 0 && periodNs > int64_t(sensor.maxDelay) * 1000)))
+        return -EINVAL;
+    if (m_recordingDemands.find(handle) == m_recordingDemands.end()) {
+        if (!active)
+            return 0;
+        HybrisRecordingDemand ui;
+        ui.active = m_manager->getActive(handle);
+        int delay = m_manager->getDelay(handle);
+        if (ui.active && batchable && delay < 0)
+            return -EIO;
+        ui.periodNs = delay < 0 ? 0 : int64_t(delay) * 1000;
+        if (!ui.active) {
+            int error = activateHardware(handle, false);
+            if (error)
+                return error;
+        }
+        m_recordingDemands.emplace(handle, HybrisRecordingArbiter(batchable, ui));
+    }
+    HybrisRecordingDemand request;
+    request.active = active;
+    request.periodNs = periodNs;
+    request.latencyNs = latencyNs;
+    return updateDemand(handle, HybrisRecordingArbiter::Recorder, request);
+}
+
+int HybrisBackendBinderHidl::beginRawRecording(size_t capacity)
+{
+    if (m_sensorInterfaceEnum != SENSOR_INTERFACE_1_0 || !m_client)
+        return -ENOTSUP;
+    if (m_rawRecording)
+        return -EBUSY; // Never silently discard unread data or loss counters.
+    try {
+        m_rawRecording.reset(new HybrisRawQueue(capacity));
+    } catch (const std::invalid_argument &) {
+        return -EINVAL;
+    } catch (const std::bad_alloc &) {
+        return -ENOMEM;
+    }
+    m_recordingFlushRequested = false;
+    m_recordingFlushFailed = false;
+    m_recordingFlushPending.clear();
+    return 0;
+}
+
+int HybrisBackendBinderHidl::requestRecordingFlush()
+{
+    if (m_captureClosed)
+        return -ESHUTDOWN;
+    if (!m_rawRecording || !m_rawRecording->complete() || m_recordingFlushFailed)
+        return -EIO;
+    if (!m_recordingFlushPending.empty())
+        return -EBUSY;
+    if (m_storageCheckpoint && !m_checkpointDurable)
+        return -EBUSY;
+    int wakeError = holdRecordingWake();
+    if (wakeError) return wakeError;
+    m_storageCheckpoint = 0;
+    m_checkpointDurable = false;
+    m_recordingFlushRequested = true;
+    if (!m_flushDeadline) {
+        m_flushDeadline.reset(new QTimer);
+        m_flushDeadline->setSingleShot(true);
+        QObject::connect(m_flushDeadline.get(), &QTimer::timeout, m_manager, [this] {
+            m_recordingFlushFailed = true;
+            if (m_rawRecording) m_rawRecording->noteInputFailure();
+            releaseRecordingDemands();
+            qCWarning(lcSensorFw) << "Recording checkpoint timed out";
+        });
+    }
+    m_flushDeadline->start(10000);
+    for (const auto &entry : m_recordingDemands) {
+        if (!entry.second.request(HybrisRecordingArbiter::Recorder).active)
+            continue;
+        int index = m_manager->indexForHandle(entry.first);
+        if (index < 0) {
+            m_recordingFlushFailed = true;
+            return -EINVAL;
+        }
+        if (((m_sensorArray[index].flags >> 1) & 7) == 2)
+            continue; // One-shot sensors do not implement HAL flush.
+        GBinderLocalRequest *req = gbinder_client_new_request2(m_client, FLUSH);
+        gbinder_local_request_append_int32(req, entry.first);
+        int32_t status = 0;
+        GBinderRemoteReply *reply = gbinder_client_transact_sync_reply(m_client, FLUSH, req, &status);
+        gbinder_local_request_unref(req);
+        GBinderReader reader;
+        if (reply)
+            gbinder_remote_reply_init_reader(reply, &reader);
+        int error = hybrisControlResult(status, reply != nullptr, [&reader](int32_t *value) {
+            return gbinder_reader_read_int32(&reader, value);
+        });
+        gbinder_remote_reply_unref(reply);
+        if (error) {
+            m_recordingFlushFailed = true;
+            return error;
+        }
+        m_recordingFlushPending.insert(entry.first);
+    }
+    pumpRawStorage();
+    return 0;
+}
+
+bool HybrisBackendBinderHidl::recordingFlushComplete() const
+{
+    // Only HAL delivery: the consumer must still write and fsync every queued
+    // record before acknowledging a durable checkpoint to the suspend policy.
+    return m_recordingFlushRequested && !m_recordingFlushFailed &&
+        m_recordingFlushPending.empty() && m_rawRecording && m_rawRecording->complete();
+}
+
+int HybrisBackendBinderHidl::beginRawStorage(const std::string &directory,
+        const std::string &identity, uint64_t segmentLimit, uint64_t totalLimit,
+        uint64_t reserveBytes)
+{
+    if (m_rawRecording || m_storageWorker)
+        return -EBUSY;
+    m_recordingWake.reset(new HybrisRecordingWakeGuard);
+    int wakeError = m_recordingWake->acquire();
+    if (wakeError) {
+        m_recordingWake.reset();
+        return wakeError;
+    }
+    int error = beginRawRecording(4096);
+    if (error) {
+        m_recordingWake.reset();
+        return error;
+    }
+    try {
+        m_storageWorker.reset(new HybrisStorageWorker(directory, identity, segmentLimit, totalLimit, 4096, reserveBytes));
+        m_storageNotifier.reset(new QSocketNotifier(m_storageWorker->notificationFd(), QSocketNotifier::Read));
+        QObject::connect(m_storageNotifier.get(), &QSocketNotifier::activated, m_manager,
+            [this] { m_storageWorker->clearNotification(); pumpRawStorage(); });
+    } catch (const std::system_error &e) {
+        m_storageNotifier.reset();
+        m_storageWorker.reset();
+        terminateFailedStorage(-std::max(1, e.code().value()));
+        return -std::max(1, e.code().value());
+    } catch (...) {
+        m_storageNotifier.reset();
+        m_storageWorker.reset();
+        terminateFailedStorage(-ENOMEM);
+        return -ENOMEM;
+    }
+    return 0; // Wait for recordingStorageStatus()==1 before enabling handles.
+}
+
+int HybrisBackendBinderHidl::recordingStorageStatus() const
+{
+    return m_storageWorker ? m_storageWorker->status() : -ENODEV;
+}
+
+int HybrisBackendBinderHidl::holdRecordingWake()
+{
+    if (!m_recordingWake) return 0;
+    int error = m_recordingWake->acquire();
+    if (error && !m_wakeFailureObserved) {
+        m_wakeFailureObserved = true;
+        m_recordingFlushFailed = true;
+        if (m_rawRecording) m_rawRecording->noteInputFailure();
+        qCWarning(lcSensorFw) << "Recording wake hold failed" << error;
+    }
+    return error;
+}
+
+void HybrisBackendBinderHidl::terminateFailedStorage(int error)
+{
+    if (m_storageFailureObserved) return;
+    m_storageFailureObserved = true;
+    // The worker has failed (or construction failed). No further storage work
+    // can succeed. Seal input before releasing demands or the recording hold.
+    // Preserve all counters/queued data and keep completion explicitly false.
+    m_stopRequested = true;
+    m_captureClosed = true;
+    m_recordingFlushFailed = true;
+    if (m_rawRecording) m_rawRecording->noteInputFailure();
+    if (m_flushDeadline) m_flushDeadline->stop();
+    qCWarning(lcSensorFw) << "Raw sensor storage terminated with failure" << error;
+    if (releaseRecordingDemands())
+        qCWarning(lcSensorFw) << "Failed to release all recorder demands after storage failure";
+    if (m_recordingWake) {
+        const int wakeError = m_recordingWake->releaseForTerminatedCapture();
+        if (wakeError) {
+            m_wakeFailureObserved = true;
+            qCWarning(lcSensorFw) << "Failed recording wake release failed" << wakeError;
+        }
+    }
+}
+
+void HybrisBackendBinderHidl::pumpRawStorage()
+{
+    if (!m_storageWorker || !m_rawRecording)
+        return;
+    if (m_storageWorker->status() < 0) {
+        terminateFailedStorage(m_storageWorker->status());
+        return;
+    }
+    const uint64_t completed = m_storageWorker->completion();
+    if (m_backgroundCheckpoint && (completed >> 1) == m_backgroundCheckpoint)
+        m_backgroundCheckpoint = 0;
+    if (m_storageCheckpoint && completed == ((m_storageCheckpoint << 1) | 1))
+        m_checkpointDurable = true;
+    if (m_stopRequested && !m_captureClosed && recordingFlushComplete()) {
+        // Final boundary is the complete received poll batch containing the
+        // last requested flush marker. Future polls continue serving UI clients.
+        m_captureClosed = true;
+        if (releaseRecordingDemands()) {
+            m_recordingFlushFailed = true;
+            m_rawRecording->noteInputFailure();
+            return;
+        }
+    }
+    while (const auto *record = m_rawRecording->front()) {
+        if (!m_storageWorker->submit(*record))
+            break;
+        m_rawRecording->consume(record->sequence);
+    }
+    if (!m_storageCheckpoint && !m_checkpointDurable && recordingFlushComplete() && !m_rawRecording->size())
+        m_storageCheckpoint = m_storageWorker->checkpoint(m_rawRecording->dropped(),
+                                                         m_rawRecording->inputFailures(), m_captureClosed);
+    if (recordingCheckpointComplete() && m_flushDeadline)
+        m_flushDeadline->stop();
+    // Save naturally delivered batches even without a client-requested flush.
+    // Keep manual checkpoint completion latched independently: later automatic
+    // checkpoints must not erase an acknowledgement a client has yet to read.
+    const bool manualPending = m_recordingFlushRequested && !m_checkpointDurable;
+    if (!m_captureClosed && !manualPending && !m_backgroundCheckpoint &&
+        !m_rawRecording->size() && m_rawRecording->complete() &&
+        m_storageWorker->durableRecords() < m_rawRecording->received())
+        m_backgroundCheckpoint = m_storageWorker->checkpoint(0, 0);
+    if (m_recordingWake) {
+        int error = m_recordingWake->releaseIfDurable(m_rawRecording->received(),
+            m_storageWorker->durableRecords(), m_rawRecording->complete() &&
+            !m_recordingFlushFailed && m_storageWorker->status() == 1,
+            manualPending || m_backgroundCheckpoint != 0);
+        if (error && error != -EAGAIN && !m_wakeFailureObserved) {
+            m_wakeFailureObserved = true;
+            m_recordingFlushFailed = true;
+            m_rawRecording->noteInputFailure();
+            qCWarning(lcSensorFw) << "Recording wake release failed" << error;
+        }
+    }
+}
+
+int HybrisBackendBinderHidl::stopRecording()
+{
+    if (m_stopRequested) return m_recordingFlushFailed ? -EIO : 0;
+    if (!m_storageWorker || m_storageWorker->status() != 1) return -EIO;
+    if (!m_recordingFlushPending.empty() || (m_storageCheckpoint &&
+        !m_checkpointDurable)) return -EBUSY;
+    m_stopRequested = true;
+    int error = requestRecordingFlush();
+    if (error) m_recordingFlushFailed = true;
+    return error;
+}
+
+int HybrisBackendBinderHidl::releaseRecordingDemands()
+{
+    int result = 0;
+    for (const auto &entry : m_recordingDemands) {
+        if (entry.second.request(HybrisRecordingArbiter::Recorder).active) {
+            int error = setRecordingDemand(entry.first, false, 0, 0);
+            if (error) result = error;
+        }
+    }
+    return result;
+}
+
+void HybrisBackendBinderHidl::startRecordingControl()
+{
+    const QString path = qEnvironmentVariable("HOKI_RECORDING_SOCKET");
+    if (path.isEmpty() || m_recordingControl) return;
+    m_recordingControl.reset(new HybrisRecordingSocket);
+    if (!m_recordingControl->listen(path, [this](const QJsonObject &request) {
+            return recordingControl(request);
+        })) {
+        qCWarning(lcSensorFw) << "Could not create private recording control socket";
+        m_recordingControl.reset();
+    }
+}
+
+QJsonObject HybrisBackendBinderHidl::recordingControl(const QJsonObject &request)
+{
+    const QString command = request.value("command").toString();
+    auto number = [&request](const char *key, int64_t maximum, int64_t &out) {
+        auto value = request.value(key);
+        if (!value.isDouble()) return false;
+        double number = value.toDouble();
+        if (!std::isfinite(number) || number < 0 || number > maximum || std::floor(number) != number)
+            return false;
+        out = static_cast<int64_t>(number);
+        return true;
+    };
+    QJsonObject reply;
+    int error = 0;
+    const QString sessionId = request.value("session_id").toString();
+    const bool mutates = command == "demand" || command == "flush" ||
+        command == "release" || command == "stop";
+    if (mutates && !m_recordingOwner.accepts(sessionId.toStdString()))
+        return QJsonObject{{"error", -EPERM}};
+    if (command == "inventory") {
+        reply.insert("session_ownership", true);
+        QJsonArray sensors;
+        for (int i = 0; i < m_sensorCount; ++i) {
+            const auto &sensor = m_sensorArray[i];
+            sensors.append(QJsonObject{{"handle", sensor.handle}, {"type", sensor.type},
+                {"name", QString::fromUtf8(sensor.name.data.str)},
+                {"flags", double(sensor.flags)}, {"min_delay_us", sensor.minDelay},
+                {"max_delay_us", sensor.maxDelay}});
+        }
+        reply.insert("sensors", sensors);
+    } else if (command == "open") {
+        auto directory = request.value("directory");
+        int64_t segment = 4LL * 1024 * 1024;
+        int64_t total = 256LL * 1024 * 1024;
+        int64_t reserve = 256LL * 1024 * 1024;
+        const bool limitsValid =
+            (!request.contains("segment_bytes") || number("segment_bytes", 64LL*1024*1024, segment)) &&
+            (!request.contains("total_bytes") || number("total_bytes", 2LL*1024*1024*1024, total)) &&
+            (!request.contains("reserve_bytes") || number("reserve_bytes", 2LL*1024*1024*1024, reserve)) &&
+            segment >= 1024*1024 && total >= segment && reserve >= 64LL*1024*1024;
+        QFile boot("/proc/sys/kernel/random/boot_id");
+        const bool ownerValid = !request.contains("session_id") ||
+            (request.value("session_id").isString() && HybrisRecordingOwner::valid(sessionId.toStdString()));
+        if (!ownerValid || !limitsValid || !directory.isString() || !QFileInfo(directory.toString()).isAbsolute() ||
+            directory.toString().contains(QChar(0)) || !boot.open(QIODevice::ReadOnly)) {
+            error = -EINVAL;
+        } else {
+            QJsonObject identity{{"version", 1}, {"session_id", sessionId}, {"boot_id", QString::fromLatin1(boot.readAll()).trimmed()},
+                {"storage", QJsonObject{{"segment_bytes", double(segment)},
+                    {"total_bytes", double(total)}, {"reserve_bytes", double(reserve)}}},
+                {"inventory", recordingControl(QJsonObject{{"command", "inventory"}})}};
+            error = beginRawStorage(directory.toString().toStdString(),
+                QJsonDocument(identity).toJson(QJsonDocument::Compact).toStdString(),
+                segment, total, reserve);
+            if (!error) {
+                m_recordingOwner.assign(sessionId.toStdString());
+                reply.insert("session_id", sessionId);
+            }
+        }
+    } else if (command == "demand") {
+        int64_t handle, period, latency;
+        if (!number("handle", INT32_MAX, handle) || !number("period_ns", 60000000000LL, period) ||
+            !number("latency_ns", 60000000000LL, latency) || !request.value("active").isBool())
+            error = -EINVAL;
+        else
+            error = setRecordingDemand(handle, request.value("active").toBool(), period, latency);
+    } else if (command == "flush") {
+        error = requestRecordingFlush();
+    } else if (command == "release") {
+        error = releaseRecordingDemands(); // Not a final drain or END assertion.
+    } else if (command == "stop") {
+        error = stopRecording();
+    } else if (command == "status") {
+        reply.insert("session_id", QString::fromStdString(m_recordingOwner.token()));
+        reply.insert("storage_status", recordingStorageStatus());
+        reply.insert("storage_aborted", m_storageFailureObserved);
+        reply.insert("hal_flush_complete", recordingFlushComplete());
+        reply.insert("checkpoint_complete", recordingCheckpointComplete());
+        reply.insert("flush_failed", m_recordingFlushFailed);
+        reply.insert("stop_requested", m_stopRequested);
+        reply.insert("stopped", m_captureClosed && recordingCheckpointComplete());
+        if (m_recordingWake) {
+            reply.insert("wake_held", m_recordingWake->held());
+            reply.insert("wake_error", m_recordingWake->error());
+        }
+        if (m_storageWorker) {
+            reply.insert("durable_records", QString::number(m_storageWorker->durableRecords()));
+            reply.insert("submitted_records", QString::number(m_storageWorker->submittedRecords()));
+        }
+        if (m_rawRecording) {
+            reply.insert("received", QString::number(m_rawRecording->received()));
+            reply.insert("dropped", QString::number(m_rawRecording->dropped()));
+            reply.insert("input_failures", QString::number(m_rawRecording->inputFailures()));
+        }
+    } else error = -EINVAL;
+    if (command != "status") pumpRawStorage();
+    reply.insert("error", error);
+    return reply;
+}
