[Unit]
Description=Tailscale node agent
Documentation=https://tailscale.com/docs/
Requisite=hoki-network-online.target
After=hoki-network-online.target connman.service

[Service]
ExecStart=/usr/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock
ExecStopPost=/usr/sbin/tailscaled --cleanup
Restart=on-failure
RestartSec=5
TimeoutStopSec=60s
RuntimeDirectory=tailscale
RuntimeDirectoryMode=0755
StateDirectory=tailscale
StateDirectoryMode=0700
Type=notify
NotifyAccess=main

[Install]
WantedBy=hoki-network-online.target
