Subject: [PATCH] Distinguish missing compass data from low calibration

Upstream-Status: Pending

diff --git a/src/main.qml b/src/main.qml
index a7586d2..7a52dbc 100644
--- a/src/main.qml
+++ b/src/main.qml
@@ -29,25 +29,28 @@ Application {
     outerColor: "#070C00"
 
     property real rotation: 0
-    property int calibration: 0
+    property real calibration: 0
+    property bool hasReading: false
 
     Compass {
         active: true
         onReadingChanged: {
+            if (!reading || !isFinite(reading.azimuth) || reading.timestamp <= 0)
+                return;
+            app.hasReading = true;
             app.rotation = reading.azimuth;
             app.calibration = reading.calibrationLevel;
         }
     }
 
     StatusPage {
-        //% "<h3>No data</h3>Calibrate the sensor by moving it in an ∞ figure."
-        text: qsTrId("id-no-data-calibrate")
-        icon: "ios-infinite-outline"
-        visible: !app.calibration
+        text: qsTr("Waiting for compass data")
+        icon: "ios-compass-outline"
+        visible: !app.hasReading
     }
 
     Item {
-        visible: app.calibration
+        visible: app.hasReading
         anchors.fill: parent
 
         Item {
@@ -65,6 +68,17 @@ Application {
                     preferShaping: true
                 }
             }
+            Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                anchors.top: magneticRotation.bottom
+                width: parent.width * 0.6
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.WordWrap
+                font.pixelSize: Dims.l(4)
+                color: "#ffcc80"
+                visible: app.calibration < 1
+                text: qsTr("Low accuracy: move in an ∞ figure to calibrate")
+            }
             Image {
                 anchors.centerIn: parent
                 anchors.verticalCenterOffset: -Dims.l(35)
