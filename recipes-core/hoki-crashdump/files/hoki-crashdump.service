[Unit]
Description=Bounded Qualcomm crash dump collector
After=local-fs.target
ConditionPathExists=/sys/module/subsystem_restart/parameters/enable_ramdumps

[Service]
ExecStartPre=/usr/sbin/hoki-crashdump prepare
ExecStart=/usr/sbin/hoki-crashdump daemon
ExecStopPost=/usr/sbin/hoki-crashdump disable
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
MemoryMax=48M
TasksMax=8
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
