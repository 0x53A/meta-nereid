import { NetworkView, SavedNetwork, NetworkDiagnostic } from "network.slint";
export struct BatteryDetails {
    power: string,
    current: string,
    voltage: string,
    ocv: string,
    charge: string,
    time: string,
    temp: string,
    cycles: string,
    resistance: string,
}

export struct Choice { label: string, action: string }

export struct LicenseEntry { name: string, license: string }

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> full-width-value: false;
    in property <bool> has-submenu: false;
    in property <bool> is-toggle: false;
    property <bool> changing: value == "turning on" || value == "turning off" || value == "starting" || value == "stopping";
    in property <length> screen-center-y: 208px;
    callback clicked();

    property <length> dist: max(screen-center-y - 208px, 208px - screen-center-y);
    property <float> norm-dist: clamp(dist / 208px, 0, 1);
    property <float> font-scale: 1.5 - 0.5 * norm-dist;
    // Exact circular inset: R - sqrt(R² - d²), with 8px margin from bezel
    property <float> dist-f: clamp(dist / 1px, 0, 207);
    property <length> curve-inset: (208.0 - sqrt(208.0 * 208.0 - root.dist-f * root.dist-f)) * 1px + 8px;
    property <length> text-width: max(0px, root.width - 48px - 2 * root.curve-inset);

    height: 48px;
    background: selected ? #1a3a5c : transparent;
    border-radius: 8px;

    in property <bool> selected: false;

    Text {
        y: root.full-width-value ? -4px : 0px;
        x: 24px + root.curve-inset;
        width: max(0px, root.full-width-value ? root.text-width - 30px : root.is-toggle ? root.text-width - 64px : root.value == ">" ? root.text-width - 40px : root.text-width * 0.6 - 8px);
        overflow: elide;
        text: root.label;
        color: root.selected ? #4da6ff : white;
        font-size: (root.full-width-value ? 16px : 20px) * root.font-scale;
        vertical-alignment: center;
        horizontal-alignment: left;
        height: root.full-width-value ? 34px : root.height;
    }

    Text {
        x: root.full-width-value ? 24px + root.curve-inset : parent.width - self.width - 24px - root.curve-inset;
        y: root.full-width-value ? 24px : 0px;
        width: root.full-width-value ? root.text-width - 30px : root.text-width * 0.4;
        overflow: elide;
        text: root.is-toggle ? "" : root.value;
        color: root.changing ? #e6c478 : root.is-toggle ? (root.value == "on" ? #4da6ff : #666666) : #aaaaaa;
        font-size: (root.full-width-value ? 12px : root.changing ? 14px : 18px) * root.font-scale;
        vertical-alignment: center;
        horizontal-alignment: root.full-width-value ? left : right;
        height: root.full-width-value ? 26px : root.height;
    }
    if root.has-submenu: Text {
        x: root.width - 48px - root.curve-inset; width: 24px; height: 48px;
        text: ">"; color: #aaaaaa; font-size: 24px; vertical-alignment: center;
    }
    if root.is-toggle: Rectangle {
        // Matches the explicit 48x48 activation region in the list's gesture handler.
        x: root.width - 24px - root.curve-inset - 48px;
        y: 0px; width: 48px; height: 48px;
        Rectangle {
            x: 10px; y: 10px; width: 28px; height: 28px; border-radius: 4px;
            border-width: 2px;
            border-color: root.changing ? #e6c478 : root.value == "on" ? #4da6ff : #999999;
            background: root.value == "on" ? #4da6ff : transparent;
            Text {
                text: root.changing ? "…" : root.value == "on" ? "✓" : root.value == "off" ? "" : "?";
                color: root.changing ? #e6c478 : white; font-size: 22px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }

}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> screen-center-y: 208px;

    property <length> dist: max(screen-center-y - 208px, 208px - screen-center-y);
    property <float> norm-dist: clamp(dist / 208px, 0, 1);
    property <float> font-scale: 1.5 - 0.5 * norm-dist;
    property <float> dist-f: clamp(dist / 1px, 0, 207);
    property <length> curve-inset: (208.0 - sqrt(208.0 * 208.0 - root.dist-f * root.dist-f)) * 1px + 8px;

    height: 28px;
    background: transparent;

    HorizontalLayout {
        padding-left: 48px + root.curve-inset;
        padding-right: 24px + root.curve-inset;
        alignment: space-between;

        Text {
            text: root.label;
            color: #666666;
            font-size: 14px * root.font-scale;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: #888888;
            font-size: 14px * root.font-scale;
            vertical-alignment: center;
        }
    }
}

component PowerButton inherits Rectangle {
    in property <bool> interactive: true;
    in property <string> label;
    in property <bool> busy: false;
    opacity: busy ? 0.5 : 1;
    in property <color> bg-color: #333333;
    in property <color> text-color: white;
    in property <length> screen-center-y: 208px;
    callback clicked();

    // 8px margin from screen edge
    property <length> margin: 8px;
    property <length> circle-r: 208px - margin;
    property <length> circle-d: 2 * circle-r;

    height: 76px;
    clip: true;
    background: transparent;

    // A full screen-radius circle, offset so only the arc slice at this Y is visible
    Rectangle {
        x: root.margin;
        y: root.height / 2 - root.screen-center-y + root.margin;
        width: root.circle-d;
        height: root.circle-d;
        border-radius: root.circle-r;
        background: root.bg-color;
    }

    TouchArea {
        enabled: root.interactive && !root.busy;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsView inherits Rectangle {
    in property <string> disk-used;
    in property <string> disk-free;
    in property <string> disk-summary;
    in property <string> disk-total;
    in property <string> disk-reserved;
    in property <int> battery-level;
    in property <bool> battery-charging;
    in property <int> cpu-cores-active;
    in property <string> wifi-status;
    in property <string> bt-status;
    in property <string> airplane-status;
    in property <string> usb-mode;
    in property <bool> acoustic-available;
    in property <bool> acoustic-on;
    in property <bool> recording-available;
    in property <bool> recording-on;
    in property <string> recording-status;
    in property <string> sleep-enabled-label;
    in property <string> face-mode;
    in property <string> ambient-face;
    in property <string> idle-time;
    in property <string> sensor-profile;
    in property <string> sleep-reason;
    in property <string> auto-cores-label;
    in property <bool> action-busy;
    in-out property <int> acoustic-volume: 30;
    in property <string> acoustic-status;
    in property <BatteryDetails> battery-details;
    in property <[LicenseEntry]> license-entries;
    in property <string> sbom-path;
    in-out property <int> license-selected-index: 0;
    in-out property <int> selected-index: 0;
    callback action(string);
    callback back();
    callback swipe-begin(float);
    callback swipe-move(float, int, int) -> int;

    in-out property <bool> show-network-menu: false;
    in-out property <int> network-page: 0;
    in-out property <int> network-selected-index: 0;
    in-out property <int> network-diagnostic-index: 0;
    in-out property <string> network-selected-path;
    in-out property <[SavedNetwork]> saved-networks;
    in-out property <[NetworkDiagnostic]> network-diagnostics;
    in-out property <SavedNetwork> network-selection;
    in-out property <bool> network-available;
    in-out property <bool> network-wifi-powered;
    in-out property <string> network-status;
    callback network-open(string);
    in-out property <bool> show-brightness-menu: false;
    in-out property <int> brightness-level: 1;
    in-out property <int> brightness-maximum: 100;
    in-out property <bool> brightness-available: false;
    in-out property <bool> auto-brightness: false;
    in-out property <bool> ambient-auto-brightness: false;
    in-out property <bool> brightness-dragging: false;
    in-out property <string> brightness-status;
    in-out property <bool> show-power-menu: false;
    in-out property <bool> show-battery-menu: false;
    in-out property <bool> show-storage-menu: false;
    in-out property <bool> show-health-menu: false;
    in-out property <bool> show-licenses-menu: false;

    in-out property <bool> show-choice-menu: false;
    in property <string> choice-title;
    in property <[Choice]> choices;
    in-out property <int> choice-index;
    in property <string> choice-current;
    callback activate-row(int, bool);

    background: black;

    // --- Scrollable settings list ---
    property <length> item-height: 50px;
    property <length> header-height: 72px;
    // Base rows (0..8), then the optional acoustic row and its volume slider,
    // followed by Health & sleep and the PIN management entry.
    property <int> health-index: 9 + (acoustic-available ? 1 : 0) + (acoustic-available && acoustic-on ? 1 : 0);
    property <int> total-items: health-index + 10;
    property <int> license-first-index: clamp(license-selected-index - 1, 0, max(0, license-entries.length - 4));
    property <length> bottom-pad: 208px;
    property <length> scroll-offset: (show-network-menu || show-brightness-menu || show-battery-menu || show-storage-menu || show-health-menu || show-licenses-menu) ? 0px : clamp(
        selected-index * item-height - 120px,
        0px,
        max(0px, header-height + total-items * item-height + bottom-pad - 416px)
    );

    if !show-network-menu && !show-brightness-menu && !show-battery-menu && !show-storage-menu && !show-health-menu && !show-licenses-menu: Flickable {
        interactive: false;
        viewport-height: root.header-height + root.total-items * root.item-height + root.bottom-pad;
        viewport-y: -root.scroll-offset;

        VerticalLayout {
            padding-top: 44px;
            padding-bottom: root.bottom-pad;
            spacing: 0px;

            Text {
                text: "Settings";
                color: #666666;
                font-size: 14px;
                horizontal-alignment: center;
                height: 28px;
            }

            VerticalLayout {
                spacing: 2px;

                SettingsRow {
                    label: battery-charging ? "Battery (chg)" : "Battery";
                    value: battery-level >= 0 ? "\{battery-level}% >" : "...";
                    selected: root.selected-index == 0;
                    screen-center-y: 96px + 0 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "Storage";
                    value: root.disk-summary;
                    full-width-value: true; has-submenu: true;
                    selected: root.selected-index == 1;
                    screen-center-y: 96px + root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "CPU cores";
                    value: "\{cpu-cores-active}";
                    selected: root.selected-index == 2;
                    screen-center-y: 96px + 2 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "Auto cores";
                    value: root.auto-cores-label;
                    is-toggle: true;
                    selected: root.selected-index == 3;
                    screen-center-y: 96px + 3 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "Wi-Fi";
                    value: root.wifi-status;
                    is-toggle: true;
                    selected: root.selected-index == 4;
                    screen-center-y: 96px + 4 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "Bluetooth";
                    value: root.bt-status;
                    full-width-value: true; has-submenu: true;
                    selected: root.selected-index == 5;
                    screen-center-y: 96px + 5 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "Network"; value: ">";
                    selected: root.selected-index == 6;
                    screen-center-y: 96px + 6 * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Airplane"; value: root.airplane-status; is-toggle: true;
                    selected: root.selected-index == 7;
                    screen-center-y: 96px + 7 * root.item-height - root.scroll-offset;
                }

                SettingsRow {
                    label: "USB";
                    value: root.usb-mode; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == 8;
                    screen-center-y: 96px + 8 * root.item-height - root.scroll-offset;
                }

                if root.acoustic-available: SettingsRow {
                    label: "Acoustic SSH";
                    value: root.acoustic-status;
                    is-toggle: true;
                    selected: root.selected-index == 9;
                    screen-center-y: 96px + 9 * root.item-height - root.scroll-offset;
                }

                // The acoustic volume control occupies selectable slot 11
                // while active, even though it is rendered as an overlay.
                if root.acoustic-available && root.acoustic-on: Rectangle {
                    height: root.item-height - 2px;
                    background: transparent;
                }

                SettingsRow {
                    label: "Health & sleep";
                    value: root.sensor-profile; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == root.health-index;
                    screen-center-y: 96px + root.health-index * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Auto sleep"; is-toggle: true; value: root.sleep-enabled-label;
                    selected: root.selected-index == root.health-index + 1;
                    screen-center-y: 96px + (root.health-index + 1) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Face mode"; value: root.face-mode; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == root.health-index + 2;
                    screen-center-y: 96px + (root.health-index + 2) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Ambient face"; value: root.ambient-face; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == root.health-index + 3;
                    screen-center-y: 96px + (root.health-index + 3) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Idle timeout"; value: root.idle-time; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == root.health-index + 4;
                    screen-center-y: 96px + (root.health-index + 4) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Brightness"; value: !root.brightness-available ? "Unavailable" : root.auto-brightness ? "Auto" : "\{root.brightness-level}%"; full-width-value: true; has-submenu: true;
                    selected: root.selected-index == root.health-index + 5;
                    screen-center-y: 96px + (root.health-index + 5) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "PIN management"; value: ">";
                    selected: root.selected-index == root.health-index + 6;
                    screen-center-y: 96px + (root.health-index + 6) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Lock now"; value: "";
                    selected: root.selected-index == root.health-index + 7;
                    screen-center-y: 96px + (root.health-index + 7) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Power"; value: ">";
                    selected: root.selected-index == root.health-index + 8;
                    screen-center-y: 96px + (root.health-index + 8) * root.item-height - root.scroll-offset;
                }
                SettingsRow {
                    label: "Licenses"; value: ">";
                    selected: root.selected-index == root.health-index + 9;
                    screen-center-y: 96px + (root.health-index + 9) * root.item-height - root.scroll-offset;
                }
                // Licenses is ALWAYS last. Insert new entries above it.




            }
        }
    }

    // Overlay touch area for settings (tap + swipe)
    if !show-choice-menu && !show-power-menu && !show-network-menu && !show-brightness-menu && !show-battery-menu && !show-storage-menu && !show-health-menu && !show-licenses-menu: TouchArea {
        property <length> drag-start-y;
        property <length> drag-accum;
        property <bool> is-dragging: false;
        property <length> tapped-y;
        property <int> tapped-index;
        property <bool> tap-on-control;
        property <length> tapped-center-y: root.header-height + self.tapped-index * root.item-height - root.scroll-offset + 24px;
        property <float> control-dist: clamp(abs(self.tapped-center-y / 1px - 208), 0, 207);
        property <length> control-inset: (208 - sqrt(208 * 208 - self.control-dist * self.control-dist)) * 1px + 8px;
        property <length> control-right: root.width - 24px - self.control-inset;
        property <bool> control-hit: self.pressed-x >= self.control-right - 48px && self.pressed-x <= self.control-right
            && self.pressed-y >= self.tapped-center-y - 24px && self.pressed-y <= self.tapped-center-y + 24px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.drag-start-y = self.pressed-y;
                self.drag-accum = 0px;
                self.is-dragging = false;
                root.swipe-begin(self.pressed-y / 1px);
            }
            if (event.kind == PointerEventKind.up) {
                if (!self.is-dragging) {
                    self.tapped-y = self.pressed-y + root.scroll-offset - root.header-height;
                    self.tapped-index = floor(self.tapped-y / root.item-height);
                    if (self.tapped-index >= 0 && self.tapped-index < root.total-items) {
                        self.tap-on-control = self.control-hit;
                        root.selected-index = self.tapped-index;
                        root.activate-row(self.tapped-index, self.tap-on-control);
                    }
                }
            }
        }

        moved => {
            if !self.pressed { return; }
            self.drag-accum = self.mouse-y - self.drag-start-y;
            if (abs(self.drag-accum) > 20px) {
                self.is-dragging = true;
            }
            if (self.is-dragging) {
                root.selected-index = root.swipe-move(self.mouse-y / 1px, root.selected-index, root.total-items);
            }
        }
    }

    // Place the slider above the list gesture handler so horizontal drags
    // adjust volume. The rest of the list retains vertical swipe navigation.
    if acoustic-available && acoustic-on && !show-choice-menu && !show-power-menu && !show-network-menu && !show-brightness-menu && !show-battery-menu && !show-storage-menu && !show-health-menu && !show-licenses-menu: Rectangle {
        x: 70px;
        y: root.header-height + 10 * root.item-height - root.scroll-offset;
        width: 276px;
        height: root.item-height;
        background: black;
        Text {
            x: 0px; y: 0px; height: 20px; width: parent.width;
            text: "Reply volume · \{root.acoustic-volume}%";
            font-size: 18px; color: white; horizontal-alignment: center;
        }
        Rectangle {
            x: 12px; y: 34px; width: 252px; height: 6px;
            border-radius: 3px; background: #333333;
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width * root.acoustic-volume / 100;
                height: parent.height; background: #a8efce; border-radius: 3px;
            }
        }
        Rectangle {
            x: 252px * root.acoustic-volume / 100;
            y: 25px; width: 24px; height: 24px;
            border-radius: 12px; background: #a8efce;
        }
        TouchArea {
            y: 0px; height: root.item-height;
            enabled: !root.action-busy;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.acoustic-volume = round(clamp((self.mouse-x - 12px) / 252px * 100, 0, 100));
                }
                if event.kind == PointerEventKind.up {
                    root.action("acoustic-volume:" + root.acoustic-volume);
                }
            }
            moved => {
                if self.pressed {
                    root.acoustic-volume = round(clamp((self.mouse-x - 12px) / 252px * 100, 0, 100));
                }
            }
        }
    }

    if show-network-menu: NetworkView {
        networks: root.saved-networks;
        diagnostics: root.network-diagnostics;
        selected-network: root.network-selection;
        available: root.network-available;
        wifi-powered: root.network-wifi-powered;
        status: root.network-status;
        busy: root.action-busy;
        page <=> root.network-page;
        selected-index <=> root.network-selected-index;
        diagnostic-index <=> root.network-diagnostic-index;
        open-network(path) => { root.network-open(path); }
        action(a) => { root.action(a); }
        swipe-begin(y) => { root.swipe-begin(y); }
        swipe-move(y,selected,count) => { return root.swipe-move(y,selected,count); }
    }

    if show-brightness-menu: Rectangle {
        Text {
            x: 100px; y: 42px; width: 216px; height: 32px;
            text: "Brightness"; color: white; font-size: 24px; horizontal-alignment: center;
        }
        Rectangle {
            x: 58px; y: 96px; width: 300px; height: 72px;
            opacity: root.brightness-available && !root.auto-brightness ? 1 : 0.4;
            Text {
                x: 0px; y: 0px; height: 28px; width: parent.width;
                text: root.brightness-available ? "\{root.brightness-level}%" : "Unavailable";
                color: white; font-size: 22px; horizontal-alignment: center;
            }
            Rectangle {
                x: 12px; y: 48px; width: 276px; height: 6px;
                background: #333333; border-radius: 3px;
                Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width * (root.brightness-level - 1) / 99;
                    height: parent.height; background: #a8efce; border-radius: 3px;
                }
            }
            Rectangle {
                x: 276px * (root.brightness-level - 1) / 99;
                y: 39px; width: 24px; height: 24px; border-radius: 12px; background: #a8efce;
            }
            TouchArea {
                enabled: root.brightness-available && !root.auto-brightness && !root.action-busy;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.brightness-dragging = true;
                        root.brightness-level = 1 + round(clamp((self.mouse-x - 12px) / 276px, 0, 1) * 99);
                    }
                    if event.kind == PointerEventKind.up {
                        root.brightness-dragging = false;
                        root.action("brightness:" + root.brightness-level);
                    }
                    if event.kind == PointerEventKind.cancel { root.brightness-dragging = false; }
                }
                moved => {
                    if self.pressed {
                        root.brightness-level = 1 + round(clamp((self.mouse-x - 12px) / 276px, 0, 1) * 99);
                    }
                }
            }
        }
        Rectangle {
            x: 58px; y: 180px; width: 300px; height: 56px;
            opacity: root.brightness-available && !root.action-busy ? 1 : 0.4;
            Text { x: 0px; y: 0px; width: 248px; height: parent.height; text: "Auto · Normal mode";
                color: white; font-size: 20px; vertical-alignment: center; }
            Rectangle {
                x: 260px; y: 14px; width: 28px; height: 28px; border-radius: 4px;
                border-width: 2px; border-color: #a8efce;
                background: root.auto-brightness ? #a8efce : transparent;
                Text { text: root.auto-brightness ? "✓" : ""; color: black;
                    font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
            }
            TouchArea {
                x: 252px; width: 48px;
                enabled: root.brightness-available && !root.action-busy;
                clicked => { root.action("toggle-auto-brightness"); }
            }
        }
        Rectangle {
            x: 58px; y: 238px; width: 300px; height: 56px;
            opacity: root.brightness-available && !root.action-busy ? 1 : 0.4;
            Text { width: 248px; height: parent.height; text: "Auto · Low-power face";
                color: white; font-size: 20px; vertical-alignment: center; }
            Rectangle {
                x: 260px; y: 14px; width: 28px; height: 28px; border-radius: 4px;
                border-width: 2px; border-color: #a8efce;
                background: root.ambient-auto-brightness ? #a8efce : transparent;
                Text { text: root.ambient-auto-brightness ? "✓" : ""; color: black;
                    font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
            }
            TouchArea {
                x: 252px; width: 48px;
                enabled: root.brightness-available && !root.action-busy;
                clicked => { root.action("toggle-ambient-auto-brightness"); }
            }
        }
        Text {
            x: 88px; y: 300px; width: 240px; height: 48px;
            text: !root.brightness-available ? "Display settings unavailable" : root.brightness-status != "" ? root.brightness-status : root.auto-brightness ? "Adjusts to ambient light" : "Drag to set brightness";
            color: #a0aca5; font-size: 15px; wrap: word-wrap; horizontal-alignment: center;
        }
    }

    // --- Battery details: reserve the bottom 48px footer for navigation. ---
    if show-battery-menu: Rectangle {
        Text {
            x: 72px; y: 30px; width: 272px; height: 32px;
            text: battery-charging ? "Battery \{battery-level}% (chg)" : "Battery \{battery-level}%";
            color: white; font-size: 16px; horizontal-alignment: center;
        }
        InfoRow { y: 74px; label: "Power"; value: battery-details.power; screen-center-y: 88px; }
        InfoRow { y: 104px; label: "Current"; value: battery-details.current; screen-center-y: 118px; }
        InfoRow { y: 134px; label: "Voltage"; value: battery-details.voltage; screen-center-y: 148px; }
        InfoRow { y: 164px; label: "Open circuit"; value: battery-details.ocv; screen-center-y: 178px; }
        InfoRow { y: 194px; label: "Charge"; value: battery-details.charge; screen-center-y: 208px; }
        InfoRow { y: 224px; label: "Time"; value: battery-details.time; screen-center-y: 238px; }
        InfoRow { y: 254px; label: "Temperature"; value: battery-details.temp; screen-center-y: 268px; }
        InfoRow { y: 284px; label: "Cycles"; value: battery-details.cycles; screen-center-y: 298px; }
        InfoRow { y: 314px; label: "Resistance"; value: battery-details.resistance; screen-center-y: 328px; }
    }

    // Modal Power overlay. The list remains visible but cannot receive input.
    if show-power-menu: Rectangle {
        background: #000000c8;
        TouchArea { }
        PowerButton {
            y: 82px; height: 56px; width: parent.width;
            label: "Power off"; busy: root.action-busy;
            bg-color: #8b2020; screen-center-y: 110px;
            clicked => { root.action("poweroff"); }
        }
        PowerButton {
            y: 146px; height: 56px; width: parent.width;
            label: "Reboot"; busy: root.action-busy;
            bg-color: #1a3a5c; text-color: #4da6ff; screen-center-y: 174px;
            clicked => { root.action("reboot"); }
        }
        PowerButton {
            y: 210px; height: 56px; width: parent.width;
            label: "Bootloader"; busy: root.action-busy;
            bg-color: #4a3520; text-color: #cc8844; screen-center-y: 238px;
            clicked => { root.action("bootloader"); }
        }
        PowerButton {
            y: 274px; height: 56px; width: parent.width;
            label: "Back"; bg-color: #333333; screen-center-y: 302px;
            clicked => { root.back(); }
        }
        // Endpoints at the round screen edge indicate the physical side buttons.
        Rectangle { x: 350px; y: 109px; width: 44px; height: 2px; background: #eeeeee; }
        Rectangle { x: 350px; y: 301px; width: 44px; height: 2px; background: #eeeeee; }
    }

    if show-storage-menu: Rectangle {
        Text { x: 80px; y: 70px; width: 256px; height: 40px;
            text: "Storage"; color: white; font-size: 24px; horizontal-alignment: center; }
        InfoRow { y: 132px; label: "Total"; value: root.disk-total; screen-center-y: 146px; }
        InfoRow { y: 178px; label: "Used"; value: root.disk-used; screen-center-y: 192px; }
        InfoRow { y: 224px; label: "Available"; value: root.disk-free; screen-center-y: 238px; }
        InfoRow { y: 270px; label: "Reserved"; value: root.disk-reserved; screen-center-y: 284px; }
    }

    if show-health-menu: Rectangle {
        Text { x: 56px; y: 66px; width: 304px; height: 40px;
            text: "Health & sleep"; color: white; font-size: 24px; horizontal-alignment: center; }
        Rectangle {
            x: 56px; y: 150px; width: 304px; height: 72px; border-radius: 8px; background: #242424;
            Text { x: 12px; y: 8px; width: 252px; height: 28px; text: "Sensor profile";
                color: white; font-size: 22px; }
            Text { x: 12px; y: 38px; width: 252px; height: 26px; text: root.sensor-profile;
                color: #aaaaaa; font-size: 20px; }
            Text { x: 272px; width: 24px; height: 72px; text: ">";
                color: #aaaaaa; font-size: 24px; vertical-alignment: center; }
            TouchArea { enabled: !root.action-busy && !root.show-choice-menu;
                clicked => { root.action("choose-sensor-profile"); } }
        }
        Text { x: 56px; y: 252px; width: 304px; height: 24px;
            text: "Sleep status"; color: #aaaaaa; font-size: 16px; }
        Text { x: 56px; y: 278px; width: 304px; height: 62px;
            text: root.sleep-reason; color: white; font-size: 16px; wrap: word-wrap; }
    }

    if show-licenses-menu: Rectangle {
        Text { x: 80px; y: 28px; width: 256px; height: 32px;
            text: "Licenses"; color: white; font-size: 24px; horizontal-alignment: center; }
        Text { x: 64px; y: 64px; width: 288px; height: 62px;
            text: root.sbom-path; color: #aaaaaa; font-size: 13px;
            wrap: word-wrap; horizontal-alignment: center; }
        // Render only four visible entries; the manifest can have hundreds.
        for offset in 4: Rectangle {
            property <int> row-index: root.license-first-index + offset;
            property <LicenseEntry> entry: root.license-entries[self.row-index];
            visible: self.row-index < root.license-entries.length;
            x: 42px; y: 128px + offset * 54px; width: 332px; height: 54px;
            background: self.row-index == root.license-selected-index ? #1a3a5c : transparent;
            Text { x: 8px; y: 4px; width: 316px; height: 24px;
                text: parent.entry.name; color: white; font-size: 17px; overflow: elide; }
            Text { x: 8px; y: 28px; width: 316px; height: 22px;
                text: parent.entry.license; color: #aaaaaa; font-size: 14px; overflow: elide; }
        }
        TouchArea {
            x: 42px; y: 128px; width: 332px; height: 214px;
            property <length> start-y;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.start-y = self.mouse-y;
                    root.swipe-begin(self.mouse-y / 1px);
                }
            }
            moved => {
                if self.pressed && root.license-entries.length > 0 {
                    root.license-selected-index = root.swipe-move(self.mouse-y / 1px,
                        root.license-selected-index, root.license-entries.length);
                }
            }
        }
    }

    // One consistent footer for every subpage, with a full 48px touch target.
    if show-network-menu || show-brightness-menu || show-battery-menu || show-storage-menu || show-health-menu || show-licenses-menu: Rectangle {
        x: 152px; y: 350px; width: 112px; height: 48px;
        border-radius: 24px;
        background: back-touch.pressed ? #1a3a5c : #242424;
        Text {
            text: "Back"; color: white; font-size: 18px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        back-touch := TouchArea { clicked => { root.back(); } }
    }

    if show-choice-menu: Rectangle {
        background: #000000e8;
        TouchArea { }
        Text { x: 80px; y: 42px; width: 256px; height: 32px;
            text: root.choice-title; color: white; font-size: 23px; horizontal-alignment: center; }
        property <int> first-choice: clamp(root.choice-index - 2, 0, max(0, root.choices.length - 5));
        for slot in min(5, root.choices.length): PowerButton {
            property <int> index: parent.first-choice + slot;
            property <Choice> choice: root.choices[self.index];
            interactive: false;
            y: 90px + slot * 49px; height: 47px; width: parent.width;
            screen-center-y: 113px + slot * 49px;
            label: (self.choice.label == root.choice-current ? "✓ " : "") + self.choice.label;
            busy: root.action-busy;
            bg-color: self.index == root.choice-index ? #1a3a5c : #242424;
            clicked => { root.action(self.choice.action); root.show-choice-menu = false; }
        }
        TouchArea {
            x: 0px; y: 90px; width: parent.width; height: min(5, root.choices.length) * 49px;
            enabled: !root.action-busy;
            property <length> start-y;
            property <bool> dragged;
            property <int> tapped-index;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.start-y = self.mouse-y;
                    self.dragged = false;
                    self.tapped-index = parent.first-choice + floor(self.mouse-y / 49px);
                    root.swipe-begin(self.mouse-y / 1px);
                }
                if event.kind == PointerEventKind.up && !self.dragged {
                    if self.tapped-index >= 0 && self.tapped-index < root.choices.length {
                        root.action(root.choices[self.tapped-index].action);
                        root.show-choice-menu = false;
                    }
                }
                if event.kind == PointerEventKind.cancel { self.dragged = true; }
            }
            moved => {
                if self.pressed && abs(self.mouse-y - self.start-y) > 20px { self.dragged = true; }
                if self.pressed && self.dragged {
                    root.choice-index = root.swipe-move(self.mouse-y / 1px, root.choice-index, root.choices.length);
                }
            }
        }
        Rectangle {
            x: 152px; y: 350px; width: 112px; height: 48px; border-radius: 24px;
            background: #242424;
            Text { text: "Back"; color: white; font-size: 18px;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.back(); } }
        }
    }

}
