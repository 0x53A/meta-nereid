[Unit]
Description=Manual health sensor recording
After=dbus.service hoki-powerd.service hoki-health-policy.service
Requires=hoki-powerd.service hoki-health-policy.service
Wants=sensorfwd.service

[Service]
Type=notify
NotifyAccess=all
# One-off bounded full-profile trial controls; unset means ordinary manual capture.
PassEnvironment=HOKI_BUFFERED_FULL_TRIAL HOKI_BUFFERED_FULL_TRIAL_SECONDS HOKI_BUFFERED_FULL_TRIAL_LATENCY_SECONDS HOKI_BUFFERED_TRIAL_SELECTION HOKI_SPO2_POLICY
ExecStart=/usr/libexec/hoki-manual-consumer
StateDirectory=hoki-health-recordings
StateDirectoryMode=0700
RuntimeDirectory=hoki-health-recording
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=120
TimeoutStopSec=120
KillMode=mixed
Restart=no

# Deliberately no Install section: Settings starts/stops a session, not a boot policy.
