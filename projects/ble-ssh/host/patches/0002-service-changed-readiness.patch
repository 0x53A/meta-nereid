From: Hoki local maintainers <code@lukasrieger.com>
Subject: [PATCH] gatt-client: expose Service Changed discovery readiness

Current-link readiness must become false before Service Changed discovery,
not only after a link disconnect. Notify a separate lifecycle callback at
start and after all queued ranges complete. Failures remain unresolved until
fresh connection discovery; do not report success after a failed earlier
range followed by a successful later range. Keep the existing per-range
callback semantics intact and account for discovery state in is_ready().

Upstream-Status: Pending
---
--- a/src/device.c
+++ b/src/device.c
@@ -825,6 +825,7 @@
 
 	gatt_cache_cleanup(device);
 	bt_gatt_client_set_service_changed(device->client, NULL, NULL, NULL);
+	bt_gatt_client_set_service_changed_ready(device->client, NULL, NULL);
 
 	if (device->gatt_ready_id > 0) {
 		bt_gatt_client_ready_unregister(device->client,
@@ -3189,7 +3190,9 @@
 	 * gets called, so don't set svc_refreshed for a disconnected
 	 * device.
 	 */
-	device_set_svc_refreshed(dev, bdaddr_type, !err);
+	device_set_svc_refreshed(dev, bdaddr_type, !err &&
+			(browse_type != BROWSE_GATT ||
+				bt_gatt_client_is_ready(dev->client)));
 
 	g_slist_free_full(dev->eir_uuids, g_free);
 	dev->eir_uuids = NULL;
@@ -6286,6 +6289,13 @@
 	store_gatt_db(device);
 }
 
+static void gatt_service_changed_ready(bool ready, void *user_data)
+{
+	struct btd_device *device = user_data;
+
+	device_set_svc_refreshed(device, device->bdaddr_type, ready);
+}
+
 static void gatt_client_service_changed(uint16_t start_handle,
 							uint16_t end_handle,
 							void *user_data)
@@ -6357,6 +6367,9 @@
 		gatt_client_cleanup(device);
 		return;
 	}
+
+	bt_gatt_client_set_service_changed_ready(device->client,
+					gatt_service_changed_ready, device);
 
 	btd_gatt_client_connected(device->client_dbus);
 
--- a/src/shared/gatt-client.c
+++ b/src/shared/gatt-client.c
@@ -67,6 +67,10 @@
 	bt_gatt_client_service_changed_callback_t svc_chngd_callback;
 	bt_gatt_client_destroy_func_t svc_chngd_destroy;
 	void *svc_chngd_data;
+	bt_gatt_client_service_changed_ready_t svc_chngd_ready;
+	void *svc_chngd_ready_data;
+	bool svc_chngd_failed;
+	bool svc_chngd_recovering;
 
 	bt_gatt_client_debug_func_t debug_callback;
 	bt_gatt_client_destroy_func_t debug_destroy;
@@ -300,8 +304,13 @@
 	chrc->notify_id = 0;
 
 	while ((data = queue_remove_if(client->notify_list, match_notify_chrc,
-								chrc)))
+								chrc))) {
+		if (data->id == client->svc_chngd_ind_id) {
+			client->svc_chngd_ind_id = 0;
+			client->svc_chngd_registered = false;
+		}
 		notify_data_cleanup(data);
+	}
 
 	queue_remove(client->notify_chrcs, chrc);
 	notify_chrc_free(chrc);
@@ -1831,6 +1840,8 @@
 	return notify_data->id;
 }
 
+static void service_changed_maybe_ready(struct bt_gatt_client *client);
+
 static void service_changed_register_cb(uint16_t att_ecode, void *user_data)
 {
 	bool success;
@@ -1851,6 +1862,11 @@
 
 done:
 	notify_client_ready(client, success, att_ecode);
+	if (client->svc_chngd_recovering) {
+		if (!success)
+			client->svc_chngd_failed = true;
+		service_changed_maybe_ready(client);
+	}
 }
 
 static bool register_service_changed(struct bt_gatt_client *client)
@@ -1882,6 +1898,34 @@
 	return client->svc_chngd_ind_id ? true : false;
 }
 
+static void service_changed_ready(struct bt_gatt_client *client, bool ready)
+{
+	const struct queue_entry *entry;
+
+	if (client->svc_chngd_ready)
+		client->svc_chngd_ready(ready, client->svc_chngd_ready_data);
+
+	for (entry = queue_get_entries(client->clones); entry;
+							entry = entry->next) {
+		struct bt_gatt_client *clone = entry->data;
+
+		if (clone->svc_chngd_ready)
+			clone->svc_chngd_ready(ready, clone->svc_chngd_ready_data);
+	}
+}
+
+static void service_changed_maybe_ready(struct bt_gatt_client *client)
+{
+	if (client->in_svc_chngd || !queue_isempty(client->svc_chngd_queue))
+		return;
+
+	if (client->svc_chngd_ind_id && !client->svc_chngd_registered)
+		return;
+
+	client->svc_chngd_recovering = false;
+	service_changed_ready(client, !client->svc_chngd_failed);
+}
+
 static void service_changed_complete(struct discovery_op *op, bool success,
 							uint8_t att_ecode)
 {
@@ -1892,6 +1936,13 @@
 	const struct queue_entry *entry;
 
 	client->in_svc_chngd = false;
+	/* An empty changed range is a valid removal, not a discovery failure. */
+	if (!success && att_ecode == BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND) {
+		success = true;
+		op->success = true;
+	}
+	if (!success)
+		client->svc_chngd_failed = true;
 
 	if (!success && att_ecode != BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND) {
 		DBG(client,
@@ -1925,11 +1976,15 @@
 		return;
 	}
 
-	if (register_service_changed(client))
-		return;
-
-	DBG(client,
-		"Failed to re-register handler for \"Service Changed\"");
+	/* A failed range stays unresolved until a fresh connection rediscovers it.
+	 * Never report readiness between queued Service Changed ranges.
+	 */
+	if (!register_service_changed(client)) {
+		client->svc_chngd_failed = true;
+		DBG(client,
+			"Failed to re-register handler for \"Service Changed\"");
+	}
+	service_changed_maybe_ready(client);
 }
 
 static void service_changed_failure(struct discovery_op *op)
@@ -1937,6 +1992,8 @@
 	struct bt_gatt_client *client = op->client;
 
 	gatt_db_clear_range(client->db, op->start, op->end);
+	client->svc_chngd_failed = true;
+	service_changed_ready(client, false);
 }
 
 static void process_service_changed(struct bt_gatt_client *client,
@@ -1944,6 +2001,10 @@
 							uint16_t end_handle)
 {
 	struct discovery_op *op;
+
+	client->in_svc_chngd = true;
+	client->svc_chngd_recovering = true;
+	service_changed_ready(client, false);
 
 	op = discovery_op_create(client, start_handle, end_handle,
 						service_changed_complete,
@@ -1964,6 +2025,8 @@
 	discovery_op_free(op);
 
 fail:
+	client->in_svc_chngd = false;
+	client->svc_chngd_failed = true;
 	DBG(client,
 		"Failed to initiate service discovery after Service Changed");
 }
@@ -2100,6 +2163,11 @@
 
 done:
 	notify_client_ready(client, success, att_ecode);
+	if (client->svc_chngd_recovering) {
+		if (!success)
+			client->svc_chngd_failed = true;
+		service_changed_maybe_ready(client);
+	}
 }
 
 static bool gatt_client_init(struct bt_gatt_client *client, uint16_t mtu)
@@ -2458,7 +2526,16 @@
 
 bool bt_gatt_client_is_ready(struct bt_gatt_client *client)
 {
-	return (client && client->ready);
+	if (!client)
+		return false;
+
+	if (client->parent)
+		client = client->parent;
+
+	return client->ready && !client->in_svc_chngd &&
+			!client->svc_chngd_recovering &&
+			!client->svc_chngd_failed &&
+			queue_isempty(client->svc_chngd_queue);
 }
 
 unsigned int bt_gatt_client_ready_register(struct bt_gatt_client *client,
@@ -2492,6 +2569,17 @@
 	}
 
 	return false;
+}
+
+void bt_gatt_client_set_service_changed_ready(struct bt_gatt_client *client,
+				bt_gatt_client_service_changed_ready_t callback,
+				void *user_data)
+{
+	if (!client)
+		return;
+
+	client->svc_chngd_ready = callback;
+	client->svc_chngd_ready_data = user_data;
 }
 
 bool bt_gatt_client_set_service_changed(struct bt_gatt_client *client,
--- a/src/shared/gatt-client.h
+++ b/src/shared/gatt-client.h
@@ -137,3 +137,12 @@
 bool bt_gatt_client_set_retry(struct bt_gatt_client *client,
 					unsigned int id,
 					bool retry);
+
+/* Borrowed user_data: clear the callback before freeing its owner.
+ * False before Service Changed discovery; true only after all queued ranges
+ * succeed. A discovery failure remains false until a new client connection.
+ */
+typedef void (*bt_gatt_client_service_changed_ready_t)(bool ready, void *user_data);
+void bt_gatt_client_set_service_changed_ready(struct bt_gatt_client *client,
+				bt_gatt_client_service_changed_ready_t callback,
+				void *user_data);
