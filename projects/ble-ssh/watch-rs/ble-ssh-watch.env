# Read by systemd. Restart ble-ssh-watch after editing.
# Radio power remains controlled by Settings / ConnMan.
BLE_SSH_TRANSPORT=ble
# Options: ble, classic, both. Classic requires host pairing.
BLE_SSH_NAME=AsteroidOS-SSH
# SSH always connects to loopback; only its port is configurable.
BLE_SSH_PORT=22
# Reserve eight GATT handles exclusively for this daemon; no auto-renumber.
# Keep this value stable across restarts/upgrades. Decimal or 0x hex.
BLE_SSH_GATT_HANDLE=0x1000
RUST_LOG=info
