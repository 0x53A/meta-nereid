struct PbwEntry {
    name: string,
    company: string,
    filename: string,
    is-watchface: bool,
}

struct StoreEntry {
    title: string,
    author: string,
    hearts: int,
    status: string,
    has-screenshot: bool,
}

export global PebbleTheme {
    out property <color> ink: #edf3f7;
    out property <color> muted: #a9b7c4;
    out property <color> accent: #9ed8ff;
    out property <color> surface: #162434;
    out property <color> pressed: #31506a;
}

component ActionButton inherits Rectangle {
    in property <image> shape;
    in property <string> label;
    in property <string> detail: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> capture-scroll: false;
    in property <length> label-center-x: self.width / 2;
    in property <length> label-center-y: self.height / 2;
    in property <length> label-size: root.width < 100px ? 14px : 19px;
    in property <length> label-width: 0px;
    property <length> text-width: root.label-width > 0px ? root.label-width : root.width < 100px ? root.width - 8px : min(280px, root.width - 24px);
    callback clicked();
    callback scrolled(float);
    height: 56px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    Image {
        width: parent.width; height: parent.height; source: root.shape;
        colorize: !root.enabled ? #111820 : touch.pressed ? PebbleTheme.pressed : root.primary ? #315c79 : PebbleTheme.surface;
    }
    Text {
        x: root.label-center-x - root.text-width / 2; y: root.detail == "" ? root.label-center-y - 16px : 7px;
        width: root.text-width; height: root.detail == "" ? 32px : 26px;
        text: root.label; color: root.enabled ? PebbleTheme.ink : PebbleTheme.muted;
        font-size: root.label-size; font-weight: 600; overflow: elide;
        vertical-alignment: center; horizontal-alignment: center;
    }
    if root.detail != "": Text {
        x: root.label-center-x - root.text-width / 2; y: 31px; width: root.text-width; height: 18px;
        text: root.detail; color: PebbleTheme.muted; font-size: 13px;
        horizontal-alignment: center; overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); }
        scroll-event(event) => {
            if root.capture-scroll { root.scrolled(event.delta-y / 1px); return accept; }
            return reject;
        }
    }
}

component LibraryRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> badge: "";
    in property <length> screen-center-y: 208px;
    callback clicked();
    callback scrolled(float);
    property <length> distance: min(208px, max(screen-center-y - 208px, 208px - screen-center-y));
    property <length> inset: 34px + (distance * distance) / 416px;
    property <float> scale: 1.25 - 0.25 * (distance / 208px);
    height: 62px;
    background: touch.pressed ? PebbleTheme.pressed : transparent;
    Rectangle { x: root.inset; y: 60px; width: parent.width - 2 * root.inset; height: 1px; background: #252b39; }
    Text {
        x: root.inset; y: 7px; width: parent.width - 2 * root.inset; height: 29px;
        text: root.title; color: PebbleTheme.ink; font-size: 18px * root.scale;
        font-weight: 600; overflow: elide; vertical-alignment: center;
    }
    Text {
        x: root.inset; y: 38px; width: parent.width - 2 * root.inset - (root.badge != "" ? 48px : 0px); height: 17px;
        text: root.detail; color: PebbleTheme.muted; font-size: 13px; overflow: elide;
    }
    if root.badge != "": Text {
        x: parent.width - root.inset - 42px; y: 37px; width: 42px; height: 18px;
        text: root.badge; color: PebbleTheme.accent; font-size: 13px;
        horizontal-alignment: right; overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); }
        scroll-event(event) => { root.scrolled(event.delta-y / 1px); return accept; }
    }
}

export component MainWindow inherits Window {
    title: "Pebble";
    width: 416px; height: 416px;
    background: #000;
    default-font-family: "DejaVu Sans";

    // 0=home, 1=installed, 2=faces, 3=apps, 4=favorites, 5=preview, 6=settings
    in property <int> view: 0;
    in property <[PbwEntry]> apps: [];
    in property <[StoreEntry]> store-items: [];
    in property <image> framebuffer;
    in property <image> preview-image;
    in property <string> status: "";
    in property <bool> running: false;
    in-out property <bool> fullscreen-launch: false;
    in property <string> current-app: "";
    in property <bool> loading: false;
    in property <int> installed-count: 0;
    in property <string> preview-title: "";
    in property <string> preview-author: "";
    in property <string> preview-status: "";
    in property <bool> preview-is-watchface: false;
    in property <int> preview-index: -1;
    in property <bool> preview-has-image: false;
    in property <bool> watchface-mode: false;
    in property <bool> current-app-is-watchface: false;
    in-out property <bool> select-overlay: false;
    in property <bool> back-override: false;
    property <length> library-start: max(0px, (264px - root.apps.length * 62px) / 2);
    property <length> store-start: max(0px, (264px - root.store-items.length * 62px - 52px) / 2);
    in-out property <length> library-viewport-y: 0px;
    in-out property <length> store-viewport-y: 0px;
    property <float> crown-remainder: 0;
    changed view => { root.crown-remainder = 0; }
    changed running => { root.crown-remainder = 0; }
    callback crown-scroll(float);
    crown-scroll(delta) => {
        root.crown-remainder -= delta;
        if root.running && root.fullscreen-launch && !root.current-app-is-watchface {
            let steps = root.crown-remainder >= 0 ? floor(root.crown-remainder / 60) : ceil(root.crown-remainder / 60);
            root.crown-remainder -= steps * 60;
            if steps > 0 { root.button-pressed(3); }
            if steps < 0 { root.button-pressed(1); }
        } else {
            let rows = root.crown-remainder >= 0 ? floor(root.crown-remainder / 300) : ceil(root.crown-remainder / 300);
            root.crown-remainder -= rows * 300;
            if !root.running && root.view == 1 {
                root.library-viewport-y = clamp(root.library-viewport-y - rows * 62px,
                    min(0px, 264px - (root.library-start + root.apps.length * 62px + 150px)), 0px);
            } else if !root.running && (root.view == 2 || root.view == 3 || root.view == 4) {
                root.store-viewport-y = clamp(root.store-viewport-y - rows * 62px,
                    min(0px, 264px - (root.store-start + root.store-items.length * 62px + 202px)), 0px);
            }
        }
    }

    callback navigate(int);
    callback app-selected(int, bool);
    callback store-item-selected(int);
    callback back-pressed();
    callback load-more();
    callback preview-install();
    callback preview-launch();
    callback preview-use();
    callback set-as-watchface();
    callback select-overlay-changed(bool);
    // Pebble: BACK=0, UP=1, SELECT=2, DOWN=3
    callback button-pressed(int);

    // Bands use SVG cutouts at the circular bezel; their inner edges stay square.
    display := Rectangle {
    x: 0px; y: 0px; width: 416px; height: 416px;
    border-radius: 208px; background: #000;
    border-width: 1px; border-color: #1f2a39;

    if root.running && root.watchface-mode: Image {
        x: 0px; y: 0px; width: 416px; height: 416px;
        source: root.framebuffer; image-rendering: pixelated;
    }

    if root.running && root.fullscreen-launch && !root.watchface-mode: Rectangle {
        background: black;
        forward-focus: fullscreen-keys;
        fullscreen-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if !root.current-app-is-watchface {
                    if event.text == Key.F13 || event.text == Key.UpArrow { root.button-pressed(1); return accept; }
                    if event.text == Key.F14 || event.text == Key.DownArrow { root.button-pressed(3); return accept; }
                    if event.text == Key.Backspace { root.button-pressed(0); return accept; }
                    if event.text == Key.Return { root.button-pressed(2); return accept; }
                }
                if event.text == Key.Escape { root.back-pressed(); return accept; }
                return reject;
            }
        }
        Image { width: 416px; height: 416px; source: root.framebuffer; image-rendering: pixelated; }
        TouchArea { scroll-event(event) => { root.crown-scroll(event.delta-y / 1px); return accept; } }
        if root.back-override && !root.current-app-is-watchface: Rectangle {
            x: root.select-overlay ? 102px : 148px; y: 344px;
            width: root.select-overlay ? 104px : 120px; height: 54px;
            border-radius: 16px; background: #162434dd;
            border-width: 1px; border-color: PebbleTheme.accent;
            Text { text: "BACK"; color: PebbleTheme.ink; font-size: 16px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.button-pressed(0); } }
        }
        if root.select-overlay && !root.current-app-is-watchface: Rectangle {
            x: root.back-override ? 210px : 148px; y: 344px;
            width: root.back-override ? 104px : 120px; height: 54px;
            border-radius: 16px; background: #162434dd;
            border-width: 1px; border-color: PebbleTheme.accent;
            Text { text: "SELECT"; color: PebbleTheme.ink; font-size: 16px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.button-pressed(2); } }
        }
    }

    if root.running && !root.fullscreen-launch && !root.watchface-mode: Rectangle {
        background: transparent;
        forward-focus: running-keys;
        running-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if !root.current-app-is-watchface {
                    if event.text == Key.UpArrow || event.text == Key.F13 { root.button-pressed(1); return accept; }
                    if event.text == Key.DownArrow || event.text == Key.F14 { root.button-pressed(3); return accept; }
                    if event.text == Key.Return { root.button-pressed(2); return accept; }
                }
                if event.text == Key.Escape { root.back-pressed(); return accept; }
                return reject;
            }
        }
        Text {
            x: 92px; y: 34px; width: 232px; height: 24px;
            text: root.current-app; color: PebbleTheme.muted; font-size: 15px;
            horizontal-alignment: center; overflow: elide;
        }
        Image {
            x: 78px; y: 78px; width: 260px; height: 260px;
            source: root.framebuffer; image-rendering: pixelated;
        }
        if !root.current-app-is-watchface: ActionButton { x: 340px; y: 120px; width: 76px; height: 58px; shape: @image-url("bands/side-up.svg"); label: "Up"; clicked => { root.button-pressed(1); } }
        if !root.current-app-is-watchface: ActionButton { x: 340px; y: 180px; width: 76px; height: 58px; shape: @image-url("bands/side-select.svg"); label: "OK"; primary: true; clicked => { root.button-pressed(2); } }
        if !root.current-app-is-watchface: ActionButton { x: 340px; y: 240px; width: 76px; height: 58px; shape: @image-url("bands/side-down.svg"); label: "Down"; clicked => { root.button-pressed(3); } }
        ActionButton {
            x: 0px; y: 346px; width: 207px; height: 70px;
            shape: @image-url("bands/bottom-left.svg");
            label-center-x: 146px; label-center-y: 28px; label-width: 108px; label-size: 20px;
            label: "Back"; clicked => { root.back-pressed(); }
        }
        ActionButton {
            x: 209px; y: 346px; width: 207px; height: 70px;
            shape: @image-url("bands/bottom-right.svg");
            label-center-x: 60px; label-center-y: 28px; label-width: 108px; label-size: 20px;
            label: root.current-app-is-watchface ? "Use" : "Launch"; primary: true;
            clicked => {
                if root.current-app-is-watchface { root.set-as-watchface(); root.back-pressed(); }
                else { root.fullscreen-launch = true; }
            }
        }
    }

    if !root.running && root.view == 0: Rectangle {
        background: transparent;
        Text { x: 100px; y: 35px; width: 216px; height: 28px; text: "PEBBLE"; font-size: 18px; font-weight: 600; letter-spacing: 2px; color: PebbleTheme.muted; horizontal-alignment: center; }
        ActionButton { x: 0px; y: 74px; width: 416px; height: 66px; shape: @image-url("bands/home-library.svg"); label: "My library"; detail: root.installed-count == 1 ? "1 installed" : root.installed-count + " installed"; primary: true; clicked => { root.navigate(1); } }
        ActionButton { x: 0px; y: 142px; width: 416px; height: 66px; shape: @image-url("bands/home-faces.svg"); label: "Watchfaces"; clicked => { root.navigate(2); } }
        ActionButton { x: 0px; y: 210px; width: 416px; height: 66px; shape: @image-url("bands/home-apps.svg"); label: "Watch apps"; clicked => { root.navigate(3); } }
        ActionButton { x: 0px; y: 278px; width: 416px; height: 66px; shape: @image-url("bands/home-loved.svg"); label: "Most loved"; clicked => { root.navigate(4); } }
        ActionButton { x: 0px; y: 346px; width: 416px; height: 70px; shape: @image-url("bands/bottom-full.svg"); label: "Emu settings"; label-size: 20px; label-center-y: 28px; clicked => { root.navigate(6); } }
    }

    if !root.running && root.view == 6: Rectangle {
        background: transparent;
        Text { x: 86px; y: 36px; width: 244px; height: 32px; text: "Emu settings";
            color: PebbleTheme.ink; font-size: 23px; font-weight: 600; horizontal-alignment: center; }
        ActionButton { x: 0px; y: 142px; width: 416px; height: 66px;
            shape: @image-url("bands/home-apps.svg");
            label: root.select-overlay ? "Select overlay: On" : "Select overlay: Off";
            clicked => { root.select-overlay = !root.select-overlay; root.select-overlay-changed(root.select-overlay); }
        }
        Text { x: 68px; y: 218px; width: 280px; height: 90px;
            text: "Shows touch Select in fullscreen. Touch Back appears when an app overrides Back.";
            color: PebbleTheme.muted; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        ActionButton { x: 0px; y: 346px; width: 416px; height: 70px; shape: @image-url("bands/bottom-full.svg");
            label: "Back to Pebble"; label-size: 20px; label-center-y: 28px; clicked => { root.navigate(0); } }
    }

    if !root.running && root.view == 1: Rectangle {
        background: transparent;
        Text { x: 86px; y: 36px; width: 244px; height: 32px; text: "My library"; color: PebbleTheme.ink; font-size: 23px; font-weight: 600; horizontal-alignment: center; }
        if root.apps.length == 0: Rectangle {
            background: transparent;
            Text { x: 68px; y: 162px; width: 280px; height: 36px; text: "No Pebble apps yet"; color: PebbleTheme.ink; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
            Text { x: 78px; y: 206px; width: 260px; height: 56px; text: "Browse watchfaces or apps\nto get started."; color: PebbleTheme.muted; font-size: 16px; horizontal-alignment: center; wrap: word-wrap; }
        }
        if root.apps.length > 0: library-scroll := Flickable {
            x: 0px; y: 80px; width: 416px; height: 264px;
            viewport-y <=> root.library-viewport-y;
            viewport-height: library-column.preferred-height;
            TouchArea { width: 416px; height: parent.viewport-height;
                scroll-event(event) => { root.crown-scroll(event.delta-y / 1px); return accept; } }
            library-column := VerticalLayout {
                width: 416px; spacing: 0px; padding-top: root.library-start; padding-bottom: 150px;
                for app[idx] in root.apps: LibraryRow {
                    title: app.name; detail: app.company;
                    badge: app.is-watchface ? "FACE" : "APP";
                    screen-center-y: 111px + root.library-start + idx * 62px + library-scroll.viewport-y;
                    clicked => { root.app-selected(idx, false); }
                    scrolled(delta) => { root.crown-scroll(delta); }
                }
            }
        }
        ActionButton { x: 0px; y: 346px; width: 416px; height: 70px; shape: @image-url("bands/bottom-full.svg"); label: "Back to Pebble"; label-size: 20px; label-center-y: 28px; clicked => { root.navigate(0); } }
    }

    if !root.running && (root.view == 2 || root.view == 3 || root.view == 4): Rectangle {
        background: transparent;
        Text { x: 86px; y: 36px; width: 244px; height: 32px; text: root.view == 2 ? "Watchfaces" : root.view == 3 ? "Watch apps" : "Most loved"; color: PebbleTheme.ink; font-size: 23px; font-weight: 600; horizontal-alignment: center; }
        if root.loading && root.store-items.length == 0: Text { x: 78px; y: 177px; width: 260px; height: 52px; text: "Loading the store…"; color: PebbleTheme.muted; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        if !root.loading && root.store-items.length == 0: Text { x: 68px; y: 165px; width: 280px; height: 94px; text: root.status == "" ? "Nothing here yet." : root.status; color: PebbleTheme.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
        if !root.loading && root.store-items.length == 0 && root.status != "": ActionButton { x: 0px; y: 276px; width: 416px; height: 68px; shape: @image-url("bands/retry.svg"); label: "Retry"; primary: true; clicked => { root.navigate(root.view); } }
        if root.store-items.length > 0: store-scroll := Flickable {
            x: 0px; y: 80px; width: 416px; height: 264px;
            viewport-y <=> root.store-viewport-y;
            viewport-height: store-column.preferred-height;
            TouchArea { width: 416px; height: parent.viewport-height;
                scroll-event(event) => { root.crown-scroll(event.delta-y / 1px); return accept; } }
            store-column := VerticalLayout {
                width: 416px; spacing: 0px; padding-top: root.store-start; padding-bottom: 150px;
                for item[idx] in root.store-items: LibraryRow {
                    title: item.title;
                    detail: item.author;
                    badge: item.status == "installed" ? "✓" : item.status == "downloading..." ? "…" : "";
                    screen-center-y: 111px + root.store-start + idx * 62px + store-scroll.viewport-y;
                    clicked => { root.store-item-selected(idx); }
                    scrolled(delta) => { root.crown-scroll(delta); }
                }
                if !root.loading: ActionButton {
                    x: 104px; width: 208px; height: 52px; shape: @image-url("bands/list-more.svg"); label: "Load more";
                    clicked => { root.load-more(); }
                    capture-scroll: true;
                    scrolled(delta) => { root.crown-scroll(delta); }
                }
                if root.loading: Text { height: 52px; text: "Loading more…"; color: PebbleTheme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        ActionButton { x: 0px; y: 346px; width: 416px; height: 70px; shape: @image-url("bands/bottom-full.svg"); label: "Back to Pebble"; label-size: 20px; label-center-y: 28px; clicked => { root.navigate(0); } }
    }

    if !root.running && root.view == 5: Rectangle {
        background: transparent;
        Text { x: 72px; y: 35px; width: 272px; height: 34px; text: root.preview-title; color: PebbleTheme.ink; font-size: 22px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
        Text { x: 92px; y: 72px; width: 232px; height: 22px; text: root.preview-author; color: PebbleTheme.muted; font-size: 15px; horizontal-alignment: center; overflow: elide; }
        Rectangle {
            x: 104px; y: 104px; width: 208px; height: 208px;
            background: PebbleTheme.surface; clip: true;
            if root.preview-has-image: Image { x: 14px; y: 14px; width: 180px; height: 180px; source: root.preview-image; image-rendering: pixelated; }
            if !root.preview-has-image: Text { x: 20px; y: 74px; width: 168px; height: 60px; text: "Preview\nunavailable"; color: PebbleTheme.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        }
        if root.preview-status == "failed" || root.status != "": Text { x: 96px; y: 317px; width: 224px; height: 22px; text: root.status != "" ? root.status : "Download failed"; color: #ffb4ae; font-size: 14px; horizontal-alignment: center; overflow: elide; }
        ActionButton {
            x: 0px; y: 346px; width: 207px; height: 70px;
            shape: @image-url("bands/bottom-left.svg");
            label-center-x: 146px; label-center-y: 28px; label-width: 108px; label-size: 20px; label: "Back";
            clicked => { root.back-pressed(); }
        }
        ActionButton {
            x: 209px; y: 346px; width: 207px; height: 70px;
            shape: @image-url("bands/bottom-right.svg");
            label-center-x: 60px; label-center-y: 28px; label-width: 108px; label-size: 20px;
            label: root.preview-status == "installed" ? (root.preview-is-watchface ? "Use" : "Launch") : root.preview-status == "downloading..." ? "Installing" : root.preview-status == "unavailable" ? "Unavailable" : root.preview-status == "failed" ? "Retry" : "Install";
            primary: root.preview-status == "installed" || root.preview-status == "" || root.preview-status == "failed";
            enabled: root.preview-status == "installed" || root.preview-status == "" || root.preview-status == "failed";
            clicked => {
                if root.preview-status == "installed" {
                    if root.preview-is-watchface { root.preview-use(); }
                    else { root.preview-launch(); }
                }
                else { root.preview-install(); }
            }
        }
    }
    }
}
