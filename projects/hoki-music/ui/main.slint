import { BandButton, Button, DeviceRow, Theme } from "controls.slint";
export struct TrackRow { title: string, subtitle: string, key: string }
export component App inherits Window {
    width:416px; height:416px; background:#000; default-font-family:"DejaVu Sans";
    in-out property <int> page: 0;
    in property <[TrackRow]> tracks;
    in property <string> track-title: "Choose some music";
    in property <string> artist: "Local files or Navidrome";
    in property <string> source-label: "MUSIC";
    in property <string> time-label: "0:00";
    in property <float> progress: 0;
    in property <float> position: 0;
    in property <int> volume: 60;
    in property <bool> playing: false;
    in property <bool> has-track: false;
    in property <bool> busy: false;
    in property <bool> scanning: false;
    in property <string> notice;
    in-out property <bool> remote: false;
    callback action(string);
    callback play-track(string);
    callback seek(float);
    callback volume-change(int);
    callback refresh(bool);
    callback close();
    forward-focus: keys;
    keys := FocusScope { width:parent.width; height:parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.F13 { if root.page != 0 { root.page=0; } else { root.close(); } return accept; }
            if event.text == Key.UpArrow { root.volume-change(root.volume+5); return accept; }
            if event.text == Key.DownArrow { root.volume-change(root.volume - 5); return accept; }
            return reject;
        }
    }
    // Ancestor handles crown events without taking taps away from controls.
    TouchArea { x:0px; y:0px; width:416px; height:416px;
        scroll-event(event) => {
            if root.page == 0 { root.volume-change(root.volume + (event.delta-y > 0px ? -5 : 5)); return accept; }
            return reject;
        }
    Text { x:100px; y:35px; width:216px; height:28px; text:root.page == 0 ? "MUSIC" : root.page == 1 ? "LIBRARY" : root.page == 3 ? "PLAYBACK" : "SOURCES"; color:Theme.muted; font-size:18px; horizontal-alignment:center; }
    if root.page == 0 : Rectangle {
        x:0px; y:0px; width:416px; height:344px;
        BandButton { x:0px; y:72px; width:152px; height:60px; shape:@image-url("bands/playback-0.svg"); label:"‹‹"; content-x:105px; enabled:root.has-track && !root.busy; clicked => { root.action("previous"); } }
        BandButton { x:154px; y:72px; width:108px; height:60px; shape:@image-url("bands/playback-1.svg"); label:root.busy ? "…" : root.playing ? "Pause" : "Play"; primary:true; enabled:root.has-track && !root.busy; clicked => { root.action("toggle"); } }
        BandButton { x:264px; y:72px; width:152px; height:60px; shape:@image-url("bands/playback-2.svg"); label:"››"; content-x:47px; enabled:root.has-track && !root.busy; clicked => { root.action("next"); } }
        Text { x:68px; y:143px; width:280px; height:25px; text:root.source-label; color:Theme.accent; font-size:16px; horizontal-alignment:center; overflow:elide; }
        Text { x:52px; y:176px; width:312px; height:70px; text:root.track-title; color:Theme.ink; font-size:27px; font-weight:600; horizontal-alignment:center; vertical-alignment:center; wrap:word-wrap; overflow:elide; }
        TouchArea { x:52px; y:143px; width:312px; height:125px; clicked => { if root.has-track { root.page=3; } } }
        Text { x:58px; y:246px; width:300px; height:25px; text:root.artist; color:Theme.muted; font-size:18px; horizontal-alignment:center; overflow:elide; }
        BandButton { x:0px; y:276px; width:152px; height:68px; shape:@image-url("bands/volume-0.svg"); label:"−"; content-x:102px; clicked => { root.volume-change(root.volume - 5); } }
        Rectangle { x:154px; y:276px; width:108px; height:68px; background:Theme.surface;
            Text { y:3px; width:parent.width; height:28px; text:root.volume + "%"; color:Theme.ink; font-size:22px; horizontal-alignment:center; }
            Text { y:34px; width:parent.width; height:23px; text:root.time-label; color:Theme.accent; font-size:14px; horizontal-alignment:center; }
            Rectangle { x:0px; y:64px; height:3px; width:parent.width*clamp(root.progress,0,1); background:Theme.accent; }
        }
        BandButton { x:264px; y:276px; width:152px; height:68px; shape:@image-url("bands/volume-2.svg"); label:"+"; content-x:50px; clicked => { root.volume-change(root.volume+5); } }
    }
    if root.page == 1 : Rectangle {
        y:75px; width:416px; height:269px; clip:true;
        if root.tracks.length == 0 : Text { x:64px; y:55px; width:288px; height:110px; text:root.scanning ? "Reading your music…" : "No music yet\nChoose Sources to refresh"; color:Theme.muted; font-size:22px; horizontal-alignment:center; vertical-alignment:center; wrap:word-wrap; }
        Flickable { width:parent.width; height:parent.height; viewport-width:416px; viewport-height:root.tracks.length*76px+180px;
            // Only seven delegates exist, even for a large library.
            for unused[offset] in 7 : DeviceRow {
                property <int> row-index: max(0, floor(-parent.viewport-y / 76px)) + offset;
                visible: self.row-index < root.tracks.length;
                y:self.row-index*76px; width:416px;
                label:root.tracks[self.row-index].title;
                detail:root.tracks[self.row-index].subtitle;
                screen-center-y:75px + self.y + 38px + parent.viewport-y;
                clicked => { root.play-track(root.tracks[self.row-index].key); root.page=0; }
            }
        }
    }
    if root.page == 2 : Rectangle {
        x:66px; y:90px; width:284px; height:240px;
        Button { y:0px; width:284px; height:58px; label:"Local music"; primary:!root.remote; clicked => { root.remote=false; } }
        Button { y:68px; width:284px; height:58px; label:"Navidrome"; primary:root.remote; clicked => { root.remote=true; } }
        Button { y:143px; width:284px; height:58px; label:root.scanning ? "Refreshing…" : "Refresh library"; enabled:!root.scanning; clicked => { root.refresh(root.remote); } }
        Text { y:211px; width:284px; height:26px; text:root.remote ? "Server set in config.json" : "Music from ~/Music"; color:Theme.muted; font-size:16px; horizontal-alignment:center; }
    }
    if root.page == 3 : Rectangle {
        x:66px; y:94px; width:284px; height:235px;
        Text { x:0px; y:0px; width:284px; height:48px; text:root.time-label; color:Theme.accent; font-size:25px; horizontal-alignment:center; }
        Button { x:0px; y:63px; width:136px; height:64px; label:"−15 sec"; clicked => { root.seek(max(0,root.position - 15)); } }
        Button { x:148px; y:63px; width:136px; height:64px; label:"+15 sec"; clicked => { root.seek(root.position+15); } }
        Button { y:148px; width:284px; height:64px; label:"Stop playback"; clicked => { root.action("stop"); root.page=0; } }
    }
    BandButton { x:0px; y:346px; width:207px; height:70px; shape:@image-url("bands/nav-0.svg"); label:root.page == 0 ? "Sources" : "Player"; content-x:146px; content-y:28px; clicked => { root.page=root.page == 0 ? 2 : 0; } }
    BandButton { x:209px; y:346px; width:207px; height:70px; shape:@image-url("bands/nav-1.svg"); label:root.page == 1 ? "Sources" : "Library"; content-x:60px; content-y:28px; clicked => { root.page=root.page == 1 ? 2 : 1; } }
    if root.notice != "" : Rectangle {
        x:48px; y:145px; width:320px; height:136px; border-radius:12px; background:#381329; border-width:1px; border-color:Theme.accent;
        Text { x:15px; y:12px; width:290px; height:88px; text:root.notice; wrap:word-wrap; overflow:elide; color:Theme.ink; font-size:19px; horizontal-alignment:center; vertical-alignment:center; }
        Text { y:105px; width:parent.width; height:22px; text:"Tap to dismiss"; color:Theme.accent; font-size:15px; horizontal-alignment:center; }
        TouchArea { clicked => { root.action("dismiss"); } }
    }
    }
}
