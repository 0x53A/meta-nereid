struct BookEntry {
    id: string,
    title: string,
    num-chapters: int,
    progress-percent: float,
    last-position: string,
}

struct ChapterEntry {
    index: int,
    title: string,
}

// Small tappable button for controls
component CtrlButton inherits Rectangle {
    in property <string> label;
    in property <length> base-size;
    in property <bool> enabled: true;
    callback clicked;

    width: base-size * 0.16;
    height: base-size * 0.12;
    border-radius: self.height / 2;
    background: !root.enabled ? #222 : touch.pressed ? #4a3a1a : #3a3020;
    opacity: root.enabled ? 1.0 : 0.4;
    animate background { duration: 100ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.enabled ? #e8a838 : #666;
        font-size: root.base-size * 0.04;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Play/pause toggle
component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> base-size;
    callback clicked;

    width: base-size * 0.22;
    height: base-size * 0.22;
    border-radius: self.width / 2;
    background: touch.pressed ? #b07820 : #e8a838;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.playing ? "||" : ">";
        color: #1a1a2e;
        font-size: root.base-size * 0.09;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A tappable row item
component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <length> base-size;
    in property <float> progress: 0;
    in property <bool> highlighted: false;
    callback clicked;

    height: base-size * 0.13;
    background: touch.pressed ? #2a2a40 : root.highlighted ? #252538 : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Progress bar background (subtle)
    if root.progress > 0.001: Rectangle {
        x: 0;
        y: parent.height - base-size * 0.005;
        width: parent.width;
        height: base-size * 0.005;
        background: #333;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.progress;
            height: parent.height;
            background: #e8a838;
            opacity: 0.6;
        }
    }

    HorizontalLayout {
        padding-left: base-size * 0.04;
        padding-right: base-size * 0.04;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: white;
                font-size: root.base-size * 0.04;
                overflow: elide;
            }
        }

        if root.detail != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.detail;
                color: #888;
                font-size: root.base-size * 0.032;
            }
        }
    }
}

export component App inherits Window {
    // Book list
    in-out property <[BookEntry]> books: [];
    in-out property <[BookEntry]> recent-books: [];
    in-out property <[ChapterEntry]> chapters: [];

    // View state
    in-out property <bool> show-player: false;
    in-out property <bool> show-chapters: false;

    // Player state
    in-out property <string> player-book-title: "";
    in-out property <string> player-chapter-title: "";
    in-out property <int> player-chapter-index: 0;
    in-out property <int> player-total-chapters: 0;
    in-out property <string> player-position-str: "0:00";
    in-out property <string> player-duration-str: "0:00";
    in-out property <float> player-progress: 0;
    in-out property <bool> player-is-playing: false;

    // Callbacks (UI → Rust)
    callback open-book(/* id */ string);
    callback play-pause();
    callback seek-relative(/* secs */ float);
    callback next-chapter();
    callback prev-chapter();
    callback select-chapter(/* index */ int);
    callback back-to-library();

    property <length> base: min(root.width, root.height);

    background: #1a1a2e;

    // ── Library View ──────────────────────────────────────
    if !root.show-player: Rectangle {
        width: 100%;
        height: 100%;

        // Header
        Text {
            text: "Audiobooks";
            color: #e8a838;
            font-size: base * 0.058;
            font-weight: 700;
            horizontal-alignment: center;
            y: base * 0.08;
            width: 100%;
        }

        // Scrollable content area
        Flickable {
            x: base * 0.07;
            y: base * 0.17;
            width: base * 0.86;
            height: base * 0.72;

            VerticalLayout {
                spacing: base * 0.005;

                // Recently played section
                if root.recent-books.length > 0: Text {
                    text: "Continue";
                    color: #888;
                    font-size: base * 0.032;
                    horizontal-alignment: left;
                }

                for book[i] in root.recent-books: ListRow {
                    label: book.title;
                    detail: book.last-position;
                    base-size: base;
                    progress: book.progress-percent;
                    highlighted: true;
                    clicked => { root.open-book(book.id); }
                }

                // All books
                if root.recent-books.length > 0 && root.books.length > 0: Text {
                    text: "Library";
                    color: #888;
                    font-size: base * 0.032;
                    horizontal-alignment: left;
                }

                for book[i] in root.books: ListRow {
                    label: book.title;
                    detail: book.num-chapters > 1 ? book.num-chapters + " ch" : "";
                    base-size: base;
                    progress: book.progress-percent;
                    clicked => { root.open-book(book.id); }
                }

                // Empty state
                if root.books.length == 0 && root.recent-books.length == 0: Text {
                    text: "No audiobooks found.\nPlace files in\n~/Music/audiobooks/";
                    color: #666;
                    font-size: base * 0.04;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    height: base * 0.4;
                }
            }
        }
    }

    // ── Player View ───────────────────────────────────────
    if root.show-player: Rectangle {
        width: 100%;
        height: 100%;

        // Back button + title
        TouchArea {
            x: base * 0.06;
            y: base * 0.07;
            width: base * 0.12;
            height: base * 0.08;
            clicked => { root.back-to-library(); }

            Text {
                text: "<";
                color: #e8a838;
                font-size: base * 0.07;
                font-weight: 700;
            }
        }

        Text {
            text: root.player-book-title;
            color: white;
            font-size: base * 0.042;
            font-weight: 600;
            horizontal-alignment: center;
            y: base * 0.08;
            x: base * 0.18;
            width: base * 0.64;
            overflow: elide;
        }

        // Chapter name
        Text {
            text: root.player-chapter-title;
            color: #aaa;
            font-size: base * 0.035;
            horizontal-alignment: center;
            y: base * 0.15;
            width: 100%;
            overflow: elide;
        }

        // Progress bar
        Rectangle {
            x: base * 0.12;
            y: base * 0.23;
            width: base * 0.76;
            height: base * 0.015;
            border-radius: self.height / 2;
            background: #333;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * clamp(root.player-progress, 0, 1);
                height: parent.height;
                border-radius: self.height / 2;
                background: #e8a838;
            }
        }

        // Time display
        Text {
            text: root.player-position-str;
            color: #ccc;
            font-size: base * 0.035;
            x: base * 0.12;
            y: base * 0.26;
        }

        Text {
            text: root.player-duration-str;
            color: #888;
            font-size: base * 0.035;
            horizontal-alignment: right;
            x: base * 0.52;
            y: base * 0.26;
            width: base * 0.36;
        }

        // Chapter indicator
        if root.player-total-chapters > 1: Text {
            text: (root.player-chapter-index + 1) + " / " + root.player-total-chapters;
            color: #666;
            font-size: base * 0.03;
            horizontal-alignment: center;
            y: base * 0.32;
            width: 100%;
        }

        // Play/Pause — centered
        PlayButton {
            x: (root.width - self.width) / 2;
            y: base * 0.38;
            base-size: base;
            playing: root.player-is-playing;
            clicked => { root.play-pause(); }
        }

        // Control row: prev-ch, -30s, +30s, next-ch
        HorizontalLayout {
            x: base * 0.09;
            y: base * 0.64;
            width: base * 0.82;
            alignment: space-around;

            CtrlButton {
                label: "|<";
                base-size: base;
                enabled: root.player-chapter-index > 0;
                clicked => { root.prev-chapter(); }
            }

            CtrlButton {
                label: "-30";
                base-size: base;
                clicked => { root.seek-relative(-30); }
            }

            CtrlButton {
                label: "+30";
                base-size: base;
                clicked => { root.seek-relative(30); }
            }

            CtrlButton {
                label: ">|";
                base-size: base;
                enabled: root.player-chapter-index < root.player-total-chapters - 1;
                clicked => { root.next-chapter(); }
            }
        }

        // Chapter list button
        if root.player-total-chapters > 1: TouchArea {
            x: (root.width - ch-btn.width) / 2;
            y: base * 0.80;
            width: ch-btn.width;
            height: ch-btn.height;
            clicked => { root.show-chapters = true; }

            ch-btn := Rectangle {
                width: base * 0.35;
                height: base * 0.09;
                border-radius: self.height / 2;
                background: parent.pressed ? #2a2a40 : #222238;
                border-width: 1px;
                border-color: #444;

                Text {
                    text: "Chapters";
                    color: #e8a838;
                    font-size: base * 0.035;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Chapter List Overlay ──────────────────────────────
    if root.show-chapters: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        // Close on tap outside
        TouchArea {
            clicked => { root.show-chapters = false; }
        }

        Rectangle {
            x: base * 0.08;
            y: base * 0.08;
            width: base * 0.84;
            height: base * 0.84;
            border-radius: base * 0.04;
            background: #1e1e36;

            // Title
            Text {
                text: "Chapters";
                color: #e8a838;
                font-size: base * 0.045;
                font-weight: 600;
                horizontal-alignment: center;
                y: base * 0.03;
                width: 100%;
            }

            // Close button
            TouchArea {
                x: parent.width - base * 0.12;
                y: base * 0.02;
                width: base * 0.1;
                height: base * 0.08;
                clicked => { root.show-chapters = false; }

                Text {
                    text: "X";
                    color: #888;
                    font-size: base * 0.04;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Chapter list
            Flickable {
                x: base * 0.02;
                y: base * 0.1;
                width: parent.width - base * 0.04;
                height: parent.height - base * 0.14;

                VerticalLayout {
                    spacing: base * 0.005;

                    for ch[i] in root.chapters: ListRow {
                        label: ch.title;
                        detail: "";
                        base-size: base;
                        highlighted: ch.index == root.player-chapter-index;
                        clicked => {
                            root.select-chapter(ch.index);
                            root.show-chapters = false;
                        }
                    }
                }
            }
        }
    }
}
