[Unit]
Description=Persistent Hoki alarms, timers and stopwatch
Requires=user@1000.service
After=user@1000.service hoki-powerd.service

[Service]
Type=simple
User=ceres
SupplementaryGroups=system
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=HOKI_CLOCK_STATE=/var/lib/hoki-clock/state.json
ExecStart=/usr/lib/hoki-clockd
StateDirectory=hoki-clock
StateDirectoryMode=0700
AmbientCapabilities=CAP_WAKE_ALARM
CapabilityBoundingSet=CAP_WAKE_ALARM
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
